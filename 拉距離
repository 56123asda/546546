-- ==================== 玩家加入/離開處理 ====================
Players.PlayerAdded:Connect(function(player)
    if currentSelectedPlayer == nil then
        -- 如果有新玩家加入且當前未選擇玩家，自動選擇第一個其他玩家
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if currentSelectedPlayer == player then
        -- 如果當前選擇的玩家離開，選擇其他玩家
        local allPlayers = Players:GetPlayers()
        local newPlayer = nil
        
        for _, p in ipairs(allPlayers) do
            if p ~= LocalPlayer and p ~= player then
                newPlayer = p
                break
            end
        end
        
        currentSelectedPlayer = newPlayer
        updatePlayerInfo(newPlayer)
        
        -- 如果正在對該玩家維持距離，停止維持
        if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == player then
            DistanceMaintainSystem:StopMaintaining()
        end
    end
end)

-- 初始選擇一個玩家
local function initializePlayerSelection()
    local allPlayers = Players:GetPlayers()
    for _, player in ipairs(allPlayers) do
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
            break
        end
    end
    
    if not currentSelectedPlayer then
        warn("沒有其他玩家在遊戲中")
    end
end

