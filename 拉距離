-- ==================== 輸入式速度調節系統 ====================
local SpeedInputSystem = {
    CurrentSpeed = 8,
    MinSafeSpeed = 1,
    MaxSafeSpeed = 500,
    SpeedScale = 1.5,
    Acceleration = 0.5,
    Deceleration = 0.8,
    InputEnabled = true
}

function SpeedInputSystem:GetAdjustedSpeed(baseSpeed)
    return baseSpeed * self.SpeedScale
end

function SpeedInputSystem:SmoothAccelerate(currentSpeed, targetSpeed)
    if currentSpeed < targetSpeed then
        return currentSpeed + self.Acceleration * (targetSpeed - currentSpeed)
    else
        return currentSpeed - self.Deceleration * (currentSpeed - targetSpeed)
    end
end

function SpeedInputSystem:SetSpeedByInput(inputText)
    if not self.InputEnabled then return false, "速度輸入功能已禁用" end
    
    local cleanInput = string.gsub(inputText, "%s+", "")
    local speedNumber = tonumber(cleanInput)
    
    if not speedNumber then return false, "請輸入有效的數字" end
    if speedNumber < self.MinSafeSpeed then return false, string.format("速度不能低於 %d", self.MinSafeSpeed) end
    if speedNumber > self.MaxSafeSpeed then return false, string.format("速度不能高於 %d", self.MaxSafeSpeed) end
    
    self.CurrentSpeed = speedNumber
    return true, string.format("速度已設為: %d", speedNumber)
end

-- ==================== 優化的穿牆系統 ====================
local NoClipSystem = {
    Enabled = false,
    NoClipConnections = {},
    CurrentCharacter = nil,
    HeartbeatConnection = nil,
    CachedParts = {}
}

function NoClipSystem:EnableNoClip(character)
    if not character or not character:IsDescendantOf(game) then return false end
    
    self:DisableNoClip()
    
    local partsCache = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CollisionGroup = "NoCollision"
            table.insert(partsCache, part)
        end
    end
    self.CachedParts[character] = partsCache
    
    local descendantAdded = character.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.CollisionGroup = "NoCollision"
            if self.CachedParts[character] then
                table.insert(self.CachedParts[character], descendant)
            end
        end
    end)
    table.insert(self.NoClipConnections, descendantAdded)
    
    local lastCheck = tick()
    self.HeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not self.Enabled or not self.CurrentCharacter then return end
        local now = tick()
        if now - lastCheck >= 0.5 then
            lastCheck = now
            local parts = self.CachedParts[character]
            if parts then
                for i = 1, math.min(#parts, 20) do
                    local part = parts[i]
                    if part and part.Parent then part.CanCollide = false end
                end
            end
        end
    end)
    table.insert(self.NoClipConnections, self.HeartbeatConnection)
    
    self.Enabled = true
    self.CurrentCharacter = character
    return true
end

function NoClipSystem:DisableNoClip()
    if self.CurrentCharacter and self.CachedParts[self.CurrentCharacter] then
        local parts = self.CachedParts[self.CurrentCharacter]
        for _, part in ipairs(parts) do
            if part and part.Parent then
                part.CanCollide = true
                part.CollisionGroup = "Default"
            end
        end
        self.CachedParts[self.CurrentCharacter] = nil
    end
    
    for _, connection in ipairs(self.NoClipConnections) do
        if connection then pcall(function() connection:Disconnect() end) end
    end
    self.NoClipConnections = {}
    
    self.Enabled = false
    self.CurrentCharacter = nil
    self.HeartbeatConnection = nil
    return true
end

-- ==================== 狀態存儲系統 ====================
local PersistentStorage = {
    SaveState = function(self, data)
        local coreGui = game:GetService("CoreGui")
        if not coreGui then return end
        
        local storage = Instance.new("Folder")
        storage.Name = "DistanceMaintainStorage"
        storage.Parent = coreGui
        
        local oldStorage = coreGui:FindFirstChild("DistanceMaintainStorage")
        if oldStorage and oldStorage ~= storage then oldStorage:Destroy() end
        
        local state = Instance.new("StringValue")
        state.Name = "SystemState"
        state.Value = game:GetService("HttpService"):JSONEncode(data)
        state.Parent = storage
    end,
    
    LoadState = function(self)
        local coreGui = game:GetService("CoreGui")
        if not coreGui then return nil end
        
        local storage = coreGui:FindFirstChild("DistanceMaintainStorage")
        if storage then
            local stateValue = storage:FindFirstChild("SystemState")
            if stateValue then
                local success, data = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(stateValue.Value)
                end)
                if success then return data end
            end
        end
        return nil
    end
}

