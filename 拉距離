local function updateSpeedDisplay()
    SpeedInputBox.Text = tostring(SpeedInputSystem.CurrentSpeed)
    DistanceMaintainSystem.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(SpeedInputSystem.CurrentSpeed)
end

-- 速度輸入框焦點事件
SpeedInputBox.Focused:Connect(function()
    SpeedInputBox.BackgroundColor3 = Color3.fromRGB(40, 40, 80)
end)

SpeedInputBox.FocusLost:Connect(function()
    SpeedInputBox.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    -- 失去焦點時自動更新
    local inputText = SpeedInputBox.Text
    if inputText and inputText ~= "" then
        local success, message = SpeedInputSystem:SetSpeedByInput(inputText)
        if success then
            updateSpeedDisplay()
            SpeedInputBox.PlaceholderText = "已設定"
        else
            SpeedInputBox.PlaceholderText = message
        end
        task.wait(1)
        SpeedInputBox.PlaceholderText = "1-500"
    end
end)

