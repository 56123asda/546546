local function cleanup()
    DistanceMaintainSystem:StopMaintaining()
    DistanceMaintainSystem.NoClipSystem:DisableNoClip()
    if playerSelectionFrame then
        playerSelectionFrame:Destroy()
    end
    if c00ltpgui then
        c00ltpgui:Destroy()
    end
end

LocalPlayer.CharacterRemoving:Connect(cleanup)

