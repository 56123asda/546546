-- ==================== 輸入式速度調節系統 ====================
local SpeedInputSystem = {
    CurrentSpeed = 8,
    MinSafeSpeed = 1,
    MaxSafeSpeed = 500,
    SpeedScale = 1.5,
    Acceleration = 0.5,
    Deceleration = 0.8,
    InputEnabled = true
}

function SpeedInputSystem:GetAdjustedSpeed(baseSpeed)
    return baseSpeed * self.SpeedScale
end

function SpeedInputSystem:SmoothAccelerate(currentSpeed, targetSpeed)
    if currentSpeed < targetSpeed then
        return currentSpeed + self.Acceleration * (targetSpeed - currentSpeed)
    else
        return currentSpeed - self.Deceleration * (currentSpeed - targetSpeed)
    end
end

function SpeedInputSystem:SetSpeedByInput(inputText)
    if not self.InputEnabled then
        return false, "速度輸入功能已禁用"
    end
    
    -- 清理輸入
    local cleanInput = string.gsub(inputText, "%s+", "")
    
    -- 檢查是否為數字
    local speedNumber = tonumber(cleanInput)
    if not speedNumber then
        return false, "請輸入有效的數字"
    end
    
    -- 檢查範圍
    if speedNumber < self.MinSafeSpeed then
        return false, string.format("速度不能低於 %d", self.MinSafeSpeed)
    end
    
    if speedNumber > self.MaxSafeSpeed then
        return false, string.format("速度不能高於 %d", self.MaxSafeSpeed)
    end
    
    -- 設定速度
    self.CurrentSpeed = speedNumber
    return true, string.format("速度已設為: %d", speedNumber)
end

function SpeedInputSystem:ToggleInput(enabled)
    self.InputEnabled = enabled
    return enabled
end

-- ==================== 優化的穿牆系統 ====================
local NoClipSystem = {
    Enabled = false,
    NoClipConnections = {},
    CurrentCharacter = nil,
    HeartbeatConnection = nil,
    CachedParts = {}
}

function NoClipSystem:EnableNoClip(character)
    if not character or not character:IsDescendantOf(game) then 
        return false 
    end
    
    self:DisableNoClip()
    
    local partsCache = {}
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CollisionGroup = "NoCollision"
            table.insert(partsCache, part)
        end
    end
    
    self.CachedParts[character] = partsCache
    
    local descendantAdded
    descendantAdded = character.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.CollisionGroup = "NoCollision"
            table.insert(self.CachedParts[character], descendant)
        end
    end)
    
    table.insert(self.NoClipConnections, descendantAdded)
    
    local RunService = game:GetService("RunService")
    local lastCheck = tick()
    local CHECK_INTERVAL = 0.5
    
    self.HeartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not self.Enabled or not self.CurrentCharacter then 
            return 
        end
        
        local now = tick()
        if now - lastCheck >= CHECK_INTERVAL then
            lastCheck = now
            local parts = self.CachedParts[character]
            if parts then
                for i = 1, math.min(#parts, 20) do
                    local part = parts[i]
                    if part and part.Parent then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
    
    table.insert(self.NoClipConnections, self.HeartbeatConnection)
    
    self.Enabled = true
    self.CurrentCharacter = character
    return true
end

function NoClipSystem:DisableNoClip()
    if self.CurrentCharacter and self.CachedParts[self.CurrentCharacter] then
        local parts = self.CachedParts[self.CurrentCharacter]
        for _, part in ipairs(parts) do
            if part and part.Parent then
                part.CanCollide = true
                part.CollisionGroup = "Default"
            end
        end
        self.CachedParts[self.CurrentCharacter] = nil
    end
    
    for _, connection in ipairs(self.NoClipConnections) do
        if connection then
            pcall(function() connection:Disconnect() end)
        end
    end
    self.NoClipConnections = {}
    
    self.Enabled = false
    self.CurrentCharacter = nil
    self.HeartbeatConnection = nil
    return true
end

function NoClipSystem:ToggleNoClip(character)
    if self.Enabled and self.CurrentCharacter == character then
        return self:DisableNoClip()
    else
        return self:EnableNoClip(character)
    end
end

-- ==================== 改進的距離維持系統 ====================
local DistanceMaintainSystem = {
    Enabled = true,
    IsMaintaining = false,
    MoveSpeed = 12,
    MinSpeed = 1.5,
    MaxSpeed = 750,
    MaintainThread = nil,
    BodyVelocity = nil,
    BodyGyro = nil,
    BodyPosition = nil,
    LastPosition = nil,
    SpeedSystem = SpeedInputSystem,
    NoClipSystem = NoClipSystem,
    MaxForceMultiplier = 3.0,
    UseDirectPath = true,
    AutoNoClipEnabled = true,
    _isInitialized = false,
    _smoothVelocity = Vector3.zero,
    _targetVelocity = Vector3.zero,
    _currentTarget = nil,
    
    -- 距離維持相關參數
    TargetDistance = 10,       -- 預設維持距離
    MinDistance = 1,           -- 最小距離
    MaxDistance = 3000,        -- 最大距離
    Tolerance = 1.5,           -- 距離容差
    HeightOffset = 5,          -- 高度偏移
    SmoothFactor = 0.3,        -- 平滑係數
    RotationSmoothness = 0.2,  -- 旋轉平滑度
    LockHeight = false,        -- 鎖定高度功能
    LockedHeight = 0,          -- 鎖定的高度值
    StopVerticalDrift = true   -- 停止垂直浮動功能
}

function DistanceMaintainSystem:_createBodyMover(className, name, parent)
    if not parent then return nil end
    
    local existing = parent:FindFirstChild(name)
    if existing then
        existing:Destroy()
    end
    
    local mover = Instance.new(className)
    mover.Name = name
    return mover
end

function DistanceMaintainSystem:InitializeFlight()
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character or not character:IsDescendantOf(game) then 
        return false, "角色無效" 
    end
    
    local hrp = character:WaitForChild("HumanoidRootPart", 2)
    if not hrp then 
        return false, "找不到角色根節點" 
    end
    
    self:CleanupFlight()
    
    -- 創建BodyVelocity用於水平移動
    self.BodyVelocity = self:_createBodyMover("BodyVelocity", "FlightVelocity", hrp)
    if not self.BodyVelocity then return false end
    
    self.BodyVelocity.MaxForce = Vector3.new(10000, 0, 10000) * self.MaxForceMultiplier  -- Y軸設為0，禁止上下移動
    self.BodyVelocity.P = 1500
    self.BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    
    -- 創建BodyPosition用於保持高度
    self.BodyPosition = self:_createBodyMover("BodyPosition", "FlightPosition", hrp)
    if not self.BodyPosition then return false end
    
    self.BodyPosition.MaxForce = Vector3.new(0, 10000, 0) * self.MaxForceMultiplier  -- 只控制Y軸
    self.BodyPosition.P = 2000
    self.BodyPosition.Position = hrp.Position
    self.BodyPosition.D = 500  -- 阻尼係數
    
    -- 創建BodyGyro用於控制旋轉
    self.BodyGyro = self:_createBodyMover("BodyGyro", "FlightGyro", hrp)
    if not self.BodyGyro then return false end
    
    self.BodyGyro.MaxTorque = Vector3.new(10000, 10000, 10000) * self.MaxForceMultiplier
    self.BodyGyro.P = 1500
    self.BodyGyro.CFrame = hrp.CFrame
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
        
        local animate = character:FindFirstChild("Animate")
        if animate then
            animate.Disabled = true
        end
        
        humanoid.AutoRotate = false
        humanoid.AutoJumpEnabled = false
    end
    
    self.BodyVelocity.Parent = hrp
    self.BodyPosition.Parent = hrp
    self.BodyGyro.Parent = hrp
    
    self.MoveSpeed = self.SpeedSystem:GetAdjustedSpeed(self.SpeedSystem.CurrentSpeed)
    
    if self.AutoNoClipEnabled then
        local success = self.NoClipSystem:EnableNoClip(character)
        if not success then
            warn("穿牆模式啟用失敗")
        end
    end
    
    self._isInitialized = true
    self._smoothVelocity = Vector3.zero
    self._targetVelocity = Vector3.zero
    
    return true
end

function DistanceMaintainSystem:CleanupFlight()
    self._isInitialized = false
    self.IsMaintaining = false
    self._currentTarget = nil
    self.LockHeight = false
    
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    
    if character and character:IsDescendantOf(game) then
        local velocity = character:FindFirstChild("FlightVelocity")
        if velocity then
            pcall(function() velocity:Destroy() end)
        end
        
        local position = character:FindFirstChild("FlightPosition")
        if position then
            pcall(function() position:Destroy() end)
        end
        
        local gyro = character:FindFirstChild("FlightGyro")
        if gyro then
            pcall(function() gyro:Destroy() end)
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            humanoid.AutoJumpEnabled = true
            
            local animate = character:FindFirstChild("Animate")
            if animate then
                animate.Disabled = false
            end
        end
    end
    
    if self.BodyVelocity then
        pcall(function() self.BodyVelocity:Destroy() end)
        self.BodyVelocity = nil
    end
    
    if self.BodyPosition then
        pcall(function() self.BodyPosition:Destroy() end)
        self.BodyPosition = nil
    end
    
    if self.BodyGyro then
        pcall(function() self.BodyGyro:Destroy() end)
        self.BodyGyro = nil
    end
    
    self.LastPosition = nil
    
    self.NoClipSystem:DisableNoClip()
end

function DistanceMaintainSystem:CalculateMaintainPosition(targetPosition, currentPosition)
    -- 計算從目標到當前位置的方向
    local toTarget = (targetPosition - currentPosition)
    local distance = toTarget.Magnitude
    local direction = toTarget.Unit
    
    -- 計算目標維持位置
    local targetMaintainPos
    
    if distance > self.TargetDistance + self.Tolerance then
        -- 太遠了，需要靠近
        local moveDistance = distance - self.TargetDistance
        targetMaintainPos = currentPosition + direction * math.min(moveDistance, self.MoveSpeed * 0.1)
        
    elseif distance < self.TargetDistance - self.Tolerance then
        -- 太近了，需要遠離
        targetMaintainPos = currentPosition - direction * math.min(self.TargetDistance - distance, self.MoveSpeed * 0.1)
        
    else
        -- 在理想距離範圍內，保持位置
        targetMaintainPos = currentPosition
    end
    
    -- 如果鎖定高度，則使用鎖定的高度值
    if self.LockHeight then
        targetMaintainPos = Vector3.new(targetMaintainPos.X, self.LockedHeight, targetMaintainPos.Z)
    else
        -- 添加高度偏移
        targetMaintainPos = targetMaintainPos + Vector3.new(0, self.HeightOffset, 0)
    end
    
    return targetMaintainPos, distance
end

function DistanceMaintainSystem:FlyToMaintainPosition(targetPosition)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    
    if not character or not character:IsDescendantOf(game) then 
        return false 
    end
    
    if not self.BodyVelocity or not self.BodyGyro or not self.BodyPosition then 
        return false 
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local currentPos = hrp.Position
    local maintainPos, currentDistance = self:CalculateMaintainPosition(targetPosition, currentPos)
    
    -- 計算水平方向（忽略Y軸）
    local horizontalDirection = (Vector3.new(maintainPos.X, 0, maintainPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z))
    local horizontalDistance = horizontalDirection.Magnitude
    
    -- 根據水平移動距離調整速度
    local targetSpeed
    if horizontalDistance < 1 then
        targetSpeed = Vector3.zero
    elseif horizontalDistance < 5 then
        local speedFactor = horizontalDistance / 5
        local horizontalDir = horizontalDirection.Unit
        targetSpeed = horizontalDir * self.MoveSpeed * speedFactor * 0.5
    else
        local horizontalDir = horizontalDirection.Unit
        targetSpeed = horizontalDir * self.MoveSpeed
    end
    
    -- 平滑水平速度
    self._smoothVelocity = self._smoothVelocity:Lerp(targetSpeed, self.SmoothFactor)
    
    -- 設定水平速度（Y軸設為0）
    if self.BodyVelocity then
        self.BodyVelocity.Velocity = Vector3.new(self._smoothVelocity.X, 0, self._smoothVelocity.Z)
    end
    
    -- 設定高度位置
    if self.BodyPosition then
        local targetHeight
        if self.LockHeight then
            targetHeight = self.LockedHeight
        else
            targetHeight = maintainPos.Y
        end
        
        -- 平滑高度變化
        local currentHeight = hrp.Position.Y
        local smoothHeight = currentHeight + (targetHeight - currentHeight) * 0.2
        self.BodyPosition.Position = Vector3.new(currentPos.X, smoothHeight, currentPos.Z)
    end
    
    -- 面向目標（水平方向）
    if horizontalDistance > 0.1 and self.BodyGyro then
        local lookDirection = (Vector3.new(targetPosition.X, 0, targetPosition.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Unit
        if lookDirection.Magnitude > 0.1 then
            local currentCFrame = hrp.CFrame
            local targetCFrame = CFrame.new(currentPos, currentPos + lookDirection)
            local smoothedCFrame = currentCFrame:Lerp(targetCFrame, self.RotationSmoothness)
            self.BodyGyro.CFrame = smoothedCFrame
        end
    end
    
    return true, currentDistance
end

function DistanceMaintainSystem:MaintainDistanceDirect(target)
    if not self.Enabled or not self.IsMaintaining then return end
    
    local player = game:GetService("Players").LocalPlayer
    
    local lastUpdate = tick()
    local UPDATE_INTERVAL = 0.016
    
    while self.IsMaintaining and task.wait(UPDATE_INTERVAL) do
        if not target or not target:IsDescendantOf(game) then break end
        if not target.Character or not target.Character:IsDescendantOf(game) then break end
        if not player.Character or not player.Character:IsDescendantOf(game) then break end
        
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        
        if not targetRoot or not myRoot then break end
        
        local targetPos = targetRoot.Position
        local success, currentDistance = self:FlyToMaintainPosition(targetPos)
        
        if not success then break end
        
        self.LastPosition = myRoot.Position
        
        -- 更新UI上的距離顯示
        if c00ltpframe and c00ltpframe.Visible then
            local PlayerFar = c00ltpframe:FindFirstChild("PlayerFar")
            if PlayerFar then
                local lockText = self.LockHeight and " (高度鎖定)" or ""
                PlayerFar.Text = string.format("距離: %d (維持: %.1f)%s", math.floor(currentDistance + 0.5), self.TargetDistance, lockText)
            end
        end
        
        local now = tick()
        if now - lastUpdate >= 0.16 then
            lastUpdate = now
        end
    end
    
    self:CleanupFlight()
end

function DistanceMaintainSystem:StartMaintaining(target)
    if self.IsMaintaining then
        self:StopMaintaining()
        task.wait(0.1)
    end
    
    if not target or not target:IsDescendantOf(game) then
        return false, "目標無效"
    end
    
    if target == game.Players.LocalPlayer then
        return false, "無法對自己維持距離"
    end
    
    local success, err = self:InitializeFlight()
    if not success then
        return false, err or "飛行系統初始化失敗"
    end
    
    -- 記錄初始高度
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if character and character:IsDescendantOf(game) then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            self.LockedHeight = hrp.Position.Y
        end
    end
    
    self.IsMaintaining = true
    self._currentTarget = target
    
    self.MaintainThread = task.spawn(function()
        local protectedMaintain = function()
            self:MaintainDistanceDirect(target)
        end
        
        local maintainSuccess, maintainErr = pcall(protectedMaintain)
        if not maintainSuccess then
            warn("距離維持錯誤: " .. tostring(maintainErr))
            self:CleanupFlight()
        end
    end)
    
    local lockText = self.LockHeight and " (高度鎖定)" or ""
    return true, string.format("開始維持距離 (%.1f)%s", self.TargetDistance, lockText)
end

function DistanceMaintainSystem:StopMaintaining()
    self.IsMaintaining = false
    
    if self.MaintainThread then
        task.cancel(self.MaintainThread)
        self.MaintainThread = nil
    end
    
    self:CleanupFlight()
    
    return true, "停止距離維持"
end

function DistanceMaintainSystem:ToggleHeightLock()
    self.LockHeight = not self.LockHeight
    
    if self.LockHeight then
        -- 記錄當前高度
        local player = game:GetService("Players").LocalPlayer
        local character = player.Character
        if character and character:IsDescendantOf(game) then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                self.LockedHeight = hrp.Position.Y
            end
        end
        return true, "高度鎖定已啟用"
    else
        return true, "高度鎖定已關閉"
    end
end

function DistanceMaintainSystem:AdjustSpeed(amount)
    local targetSpeed = self.MoveSpeed + amount
    local minSpeed = self.SpeedSystem:GetAdjustedSpeed(self.SpeedSystem.MinSafeSpeed)
    local maxSpeed = self.SpeedSystem:GetAdjustedSpeed(self.SpeedSystem.MaxSafeSpeed)
    
    targetSpeed = math.clamp(targetSpeed, minSpeed, maxSpeed)
    
    local smoothFactor = 0.2
    self.MoveSpeed = self.MoveSpeed + (targetSpeed - self.MoveSpeed) * smoothFactor
    
    local originalSpeed = self.MoveSpeed / self.SpeedSystem.SpeedScale
    self.SpeedSystem.CurrentSpeed = math.max(1, math.floor(originalSpeed))
    
    return self.MoveSpeed
end

function DistanceMaintainSystem:SetSpeedDirectly(speed)
    if speed < SpeedInputSystem.MinSafeSpeed or speed > SpeedInputSystem.MaxSafeSpeed then
        return false, "速度超出範圍"
    end
    
    SpeedInputSystem.CurrentSpeed = speed
    self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(speed)
    return true, string.format("速度已設為: %d", speed)
end

function DistanceMaintainSystem:SetDistanceDirectly(distance)
    if distance < self.MinDistance or distance > self.MaxDistance then
        return false, string.format("距離必須在 %.1f 到 %.1f 之間", self.MinDistance, self.MaxDistance)
    end
    
    self.TargetDistance = distance
    return true, string.format("維持距離已設為: %.1f", distance)
end

