-- ==================== 拖動功能 ====================
local UserInputService = game:GetService("UserInputService")
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

local function update(input)
    if not dragging then return end
    local delta = input.Position - dragStart
    c00ltpframe.Position = UDim2.new(
        startPos.X.Scale, 
        startPos.X.Offset + delta.X,
        startPos.Y.Scale, 
        startPos.Y.Offset + delta.Y
    )
end

-- 創建一個透明的拖動區域（用於縮小狀態）
local dragArea = Instance.new("Frame")
dragArea.Name = "DragArea"
dragArea.Parent = c00ltpframe
dragArea.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
dragArea.BackgroundTransparency = 1  -- 完全透明
dragArea.BorderSizePixel = 0
dragArea.Size = UDim2.new(1, 0, 1, 0)
dragArea.ZIndex = 0  -- 確保在底層
dragArea.Visible = false  -- 初始隱藏

-- 通用拖動函數
local function setupDrag()
    -- 在拖動區域上添加拖動功能
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = c00ltpframe.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    -- 在標題上添加拖動功能（展開狀態）
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = c00ltpframe.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    Title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    -- 全局輸入監聽
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

-- 初始化拖動功能
setupDrag()

-- ==================== 玩家選擇系統 ====================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local currentSelectedPlayer = nil
local playerSelectionFrame = nil
local isMinimized = false

-- 更新玩家資訊顯示
local function updatePlayerInfo(player)
    if player then
        PlayerName.Text = player.Name
        PlayerIDs.Text = string.format("ID: %d", player.UserId)
        
        -- 獲取玩家頭像
        local success, result = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        
        if success and result then
            PlayerProfiles.Image = result
        else
            PlayerProfiles.Image = "rbxassetid://12222223187"
        end
        
        -- 更新維持按鈕狀態
        if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == player then
            MaintainButton.Image = "rbxassetid://7072725343" -- 停止圖標
        else
            MaintainButton.Image = "rbxassetid://7072725342" -- 維持圖標
        end
    else
        PlayerName.Text = "選擇玩家"
        PlayerIDs.Text = "ID: -"
        PlayerFar.Text = "距: -"
        PlayerProfiles.Image = "rbxassetid://12222223187"
    end
end

-- 更新距離顯示
local function updateDistance()
    if not currentSelectedPlayer then 
        PlayerFar.Text = "距: -"
        return 
    end
    
    local targetChar = currentSelectedPlayer.Character
    local localChar = LocalPlayer.Character
    
    if targetChar and localChar then
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local localRoot = localChar:FindFirstChild("HumanoidRootPart")
        
        if targetRoot and localRoot then
            local distance = (targetRoot.Position - localRoot.Position).Magnitude
            if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == currentSelectedPlayer then
                local lockText = ""
                if DistanceMaintainSystem.LockHeight and DistanceMaintainSystem.LockXAxis then
                    lockText = " (鎖)"
                elseif DistanceMaintainSystem.LockHeight then
                    lockText = " (高鎖)"
                elseif DistanceMaintainSystem.LockXAxis then
                    lockText = " (X鎖)"
                end
                PlayerFar.Text = string.format("距: %d (%.1f)%s", math.floor(distance + 0.5), DistanceMaintainSystem.TargetDistance, lockText)
            else
                PlayerFar.Text = string.format("距: %d", math.floor(distance + 0.5))
            end
        else
            PlayerFar.Text = "距: -"
        end
    else
        PlayerFar.Text = "距: -"
    end
end

