-- ==================== UI 控制變數 ====================
local currentSelectedPlayer = nil
local playerSelectionFrame = nil
local isMinimized = false

-- ==================== UI 功能函數 ====================
function DistanceMaintainSystem:UpdateUIState()
    if not c00ltpframe then return end
    
    if self.IsMaintaining then
        MaintainButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        MaintainButton.Text = "⏹ 維持中"
    else
        MaintainButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        MaintainButton.Text = "▶ 維持距離"
    end
    
    AutoNoClipButton.BackgroundColor3 = self.AutoNoClipEnabled and 
        Color3.fromRGB(60, 255, 120) or Color3.fromRGB(200, 100, 100)
    AutoNoClipButton.Text = self.AutoNoClipEnabled and "穿牆: ✓" or "穿牆: ✗"
    
    HeightLockButton.BackgroundColor3 = self.LockHeight and 
        Color3.fromRGB(120, 60, 255) or Color3.fromRGB(180, 120, 255)
    HeightLockButton.Text = self.LockHeight and "高度: ✓" or "高度: ✗"
    
    SpeedInputBox.Text = tostring(SpeedInputSystem.CurrentSpeed)
    DistanceInputBox.Text = string.format("%.1f", self.TargetDistance)
end

function DistanceMaintainSystem:UpdateUIDistance(distance)
    if not c00ltpframe or not PlayerFar then return end
    
    if self.IsMaintaining and self._currentTarget then
        local lockText = self.LockHeight and " 🔒" or ""
        PlayerFar.Text = string.format("距離: %d (%.1f)%s", 
            math.floor(distance + 0.5), 
            self.TargetDistance, 
            lockText)
    else
        PlayerFar.Text = "距離: -"
    end
end

local function updatePlayerInfo(player)
    if player then
        PlayerName.Text = player.Name
        PlayerIDs.Text = string.format("ID: %d", player.UserId)
        
        local success, result = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        
        PlayerProfiles.Image = success and result or "rbxassetid://12222223187"
    else
        PlayerName.Text = "請選擇玩家"
        PlayerIDs.Text = "ID: -"
        PlayerFar.Text = "距離: -"
        PlayerProfiles.Image = "rbxassetid://12222223187"
    end
end

local function updateDistance()
    if not currentSelectedPlayer then 
        PlayerFar.Text = "距離: -"
        return 
    end
    
    local targetChar = currentSelectedPlayer.Character
    local localChar = LocalPlayer.Character
    
    if targetChar and localChar then
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local localRoot = localChar:FindFirstChild("HumanoidRootPart")
        
        if targetRoot and localRoot then
            local distance = (targetRoot.Position - localRoot.Position).Magnitude
            if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == currentSelectedPlayer then
                local lockText = DistanceMaintainSystem.LockHeight and " 🔒" or ""
                PlayerFar.Text = string.format("距離: %d (%.1f)%s", 
                    math.floor(distance + 0.5), 
                    DistanceMaintainSystem.TargetDistance, 
                    lockText)
            else
                PlayerFar.Text = string.format("距離: %d", math.floor(distance + 0.5))
            end
        else
            PlayerFar.Text = "距離: -"
        end
    else
        PlayerFar.Text = "距離: -"
    end
end

