-- 跳過按鈕事件
SkipButton.MouseButton1Click:Connect(function()
    if not currentSelectedPlayer then
        createPlayerSelection()
        return
    end
    
    -- 跳過到下一玩家
    local allPlayers = Players:GetPlayers()
    local currentIndex = nil
    
    -- 找到當前選擇玩家的索引
    for i, player in ipairs(allPlayers) do
        if player == currentSelectedPlayer then
            currentIndex = i
            break
        end
    end
    
    if currentIndex then
        -- 找下一個非自己的玩家
        local nextPlayer = nil
        for i = currentIndex + 1, #allPlayers do
            if allPlayers[i] ~= LocalPlayer then
                nextPlayer = allPlayers[i]
                break
            end
        end
        
        -- 如果沒有找到，從頭開始找
        if not nextPlayer then
            for i, player in ipairs(allPlayers) do
                if player ~= LocalPlayer and player ~= currentSelectedPlayer then
                    nextPlayer = player
                    break
                end
            end
        end
        
        if nextPlayer then
            currentSelectedPlayer = nextPlayer
            updatePlayerInfo(nextPlayer)
        else
            warn("沒有其他玩家可以跳過")
        end
    end
end)

