-- ========== 初始化 ==========
local function initializePlayerSelection()
    if not DistanceMaintainSystem.SystemActive then return end
    local allPlayers = Players:GetPlayers()
    for _, player in ipairs(allPlayers) do
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
            break
        end
    end
end

local function initializeSystem()
    DistanceMaintainSystem.SystemActive = true
    DistanceMaintainSystem:InitializeCharacterListeners()
    DistanceMaintainSystem:LoadState()
    DistanceMaintainSystem:UpdateUIState()
    initializePlayerSelection()
    
    c00ltpframe.Visible = true
    
    distanceUpdateThread = task.spawn(function()
        while DistanceMaintainSystem.SystemActive and task.wait(0.5) do
            if c00ltpframe and c00ltpframe.Visible and not isMinimized then
                pcall(updateDistance)
            end
        end
    end)
    
    print("=" .. string.rep("=", 45) .. "=")
    print("          距離維持系統 - 修復拖動功能版")
    print("=" .. string.rep("=", 45) .. "=")
    print("✓ 重生自動恢復  ✓ 高度鎖定  ✓ 自動穿牆")
    print("✓ 速度/距離自定義  ✓ 完整清理  ✓ 死亡不消失")
    print("✓ 可拖動UI  ✓ 位置記憶")
    print("")
    print("當前設定:")
    print("  • 速度: " .. SpeedInputSystem.CurrentSpeed)
    print("  • 距離: " .. DistanceMaintainSystem.TargetDistance)
    print("  • 高度鎖定: " .. (DistanceMaintainSystem.LockHeight and "開啟" or "關閉"))
    print("  • 自動穿牆: " .. (DistanceMaintainSystem.AutoNoClipEnabled and "開啟" or "關閉"))
    print("=" .. string.rep("=", 45) .. "=")
    print("▶ 維持按鈕 = 點擊開始/再次點擊停止")
    print("🖱️ 拖動標題欄 = 移動視窗位置")
    print("💀 角色死亡 = UI不會消失，維持狀態會自動恢復")
end

-- 玩家離開處理
Players.PlayerRemoving:Connect(function(player)
    if not DistanceMaintainSystem.SystemActive then return end
    if currentSelectedPlayer == player then
        local allPlayers = Players:GetPlayers()
        local newPlayer = nil
        for _, p in ipairs(allPlayers) do
            if p ~= LocalPlayer and p ~= player then newPlayer = p break end
        end
        currentSelectedPlayer = newPlayer
        updatePlayerInfo(newPlayer)
        if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == player then
            DistanceMaintainSystem:StopMaintaining()
        end
    end
end)

-- 角色移除時清理物理效果，但不影響UI
LocalPlayer.CharacterRemoving:Connect(function()
    if DistanceMaintainSystem.SystemActive then
        DistanceMaintainSystem:StopMaintaining()
        DistanceMaintainSystem:CompleteCleanup()
    end
end)

