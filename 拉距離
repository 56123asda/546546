-- ========== 物理組件管理 ==========
function DistanceMaintainSystem:_createBodyMover(className, name, parent)
    if not parent then return nil end
    local existing = parent:FindFirstChild(name)
    if existing then existing:Destroy() end
    local mover = Instance.new(className)
    mover.Name = name
    return mover
end

-- ========== 完整清理 ==========
function DistanceMaintainSystem:CompleteCleanup(character)
    character = character or LocalPlayer.Character
    if not character then return end
    
    local moverNames = {"FlightVelocity", "FlightPosition", "FlightGyro", "BodyVelocity", "BodyPosition", "BodyGyro"}
    for _, name in ipairs(moverNames) do
        local mover = character:FindFirstChild(name)
        if mover then pcall(function() mover:Destroy() end) end
        
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            mover = hrp:FindFirstChild(name)
            if mover then pcall(function() mover:Destroy() end) end
        end
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            humanoid.AutoJumpEnabled = true
            local animate = character:FindFirstChild("Animate")
            if animate then animate.Disabled = false end
        end)
    end
    
    self.BodyVelocity = nil
    self.BodyPosition = nil
    self.BodyGyro = nil
    self._cleanupComplete = true
end

-- ========== 飛行初始化 ==========
function DistanceMaintainSystem:InitializeFlight()
    local character = LocalPlayer.Character
    if not character or not character:IsDescendantOf(game) then return false, "角色無效" end
    
    local hrp = character:WaitForChild("HumanoidRootPart", 2)
    if not hrp then return false, "找不到角色根節點" end
    
    self:CompleteCleanup(character)
    
    self.BodyVelocity = self:_createBodyMover("BodyVelocity", "FlightVelocity", hrp)
    if not self.BodyVelocity then return false end
    self.BodyVelocity.MaxForce = Vector3.new(10000, 0, 10000) * 3
    self.BodyVelocity.P = 1500
    self.BodyVelocity.Velocity = Vector3.zero
    self.BodyVelocity.Parent = hrp
    
    self.BodyPosition = self:_createBodyMover("BodyPosition", "FlightPosition", hrp)
    if not self.BodyPosition then return false end
    self.BodyPosition.MaxForce = Vector3.new(0, 10000, 0) * 3
    self.BodyPosition.P = 2000
    self.BodyPosition.Position = hrp.Position
    self.BodyPosition.D = 500
    self.BodyPosition.Parent = hrp
    
    self.BodyGyro = self:_createBodyMover("BodyGyro", "FlightGyro", hrp)
    if not self.BodyGyro then return false end
    self.BodyGyro.MaxTorque = Vector3.new(10000, 10000, 10000) * 3
    self.BodyGyro.P = 1500
    self.BodyGyro.CFrame = hrp.CFrame
    self.BodyGyro.Parent = hrp
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        humanoid.AutoJumpEnabled = false
        local animate = character:FindFirstChild("Animate")
        if animate then animate.Disabled = true end
    end
    
    self.MoveSpeed = self.SpeedSystem:GetAdjustedSpeed(self.SpeedSystem.CurrentSpeed)
    
    if self.AutoNoClipEnabled then
        self.NoClipSystem:EnableNoClip(character)
    end
    
    return true
end

-- ========== 距離計算 ==========
function DistanceMaintainSystem:CalculateMaintainPosition(targetPos, currentPos)
    local offset = targetPos - currentPos
    local distance = offset.Magnitude
    
    if distance < 0.001 then
        return currentPos + Vector3.new(0, self.HeightOffset, 0), distance
    end
    
    local direction = offset / distance
    local moveAmount = math.clamp(distance - self.TargetDistance, -self.MoveSpeed * 0.1, self.MoveSpeed * 0.1)
    local maintainPos = currentPos + direction * moveAmount
    
    if self.LockHeight then
        maintainPos = Vector3.new(maintainPos.X, self.LockedHeight, maintainPos.Z)
    else
        maintainPos = maintainPos + Vector3.new(0, self.HeightOffset, 0)
    end
    
    return maintainPos, distance
end

-- ========== 飛行控制 ==========
function DistanceMaintainSystem:FlyToMaintainPosition(targetPos)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp or not self.BodyVelocity or not self.BodyPosition or not self.BodyGyro then 
        return false 
    end
    
    local currentPos = hrp.Position
    local maintainPos, distance = self:CalculateMaintainPosition(targetPos, currentPos)
    
    local horizontalDir = (Vector3.new(maintainPos.X, 0, maintainPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z))
    local horizontalDist = horizontalDir.Magnitude
    
    local targetSpeed = Vector3.zero
    if horizontalDist > 0.1 then
        local speed = math.min(self.MoveSpeed, horizontalDist * 5)
        targetSpeed = horizontalDir.Unit * speed
    end
    
    self.BodyVelocity.Velocity = Vector3.new(targetSpeed.X, 0, targetSpeed.Z)
    
    local targetHeight = self.LockHeight and self.LockedHeight or maintainPos.Y
    local smoothHeight = currentPos.Y + (targetHeight - currentPos.Y) * 0.2
    self.BodyPosition.Position = Vector3.new(currentPos.X, smoothHeight, currentPos.Z)
    
    if horizontalDist > 0.5 then
        local lookDir = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Unit
        if lookDir.Magnitude > 0.1 then
            local targetCF = CFrame.new(currentPos, currentPos + lookDir)
            self.BodyGyro.CFrame = self.BodyGyro.CFrame:Lerp(targetCF, self.RotationSmoothness)
        end
    end
    
    return true, distance
end

-- ========== 主要維持循環 ==========
function DistanceMaintainSystem:MaintainDistanceDirect(target)
    while self.IsMaintaining and self.SystemActive and task.wait(0.016) do
        local success = pcall(function()
            if not target or not target:IsDescendantOf(game) then self:StopMaintaining() return end
            if not target.Character or not target.Character:IsDescendantOf(game) then self:StopMaintaining() return end
            if not LocalPlayer.Character then return end
            
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot or not myRoot then return end
            
            local success, distance = self:FlyToMaintainPosition(targetRoot.Position)
            if success then self:UpdateUIDistance(distance) end
        end)
        
        if not success then
            warn("距離維持錯誤，自動重試")
            task.wait(0.1)
        end
    end
    self:CleanupFlight()
end

-- ========== 開始/停止 ==========
function DistanceMaintainSystem:StartMaintaining(target)
    if not self.SystemActive then return false, "系統已關閉" end
    if self.IsMaintaining then self:StopMaintaining() task.wait(0.1) end
    if not target or target == LocalPlayer then return false, "目標無效" end
    
    self._pendingTarget = target
    self._wasMaintaining = true
    self._lastSpeed = SpeedInputSystem.CurrentSpeed
    self._lastHeightLock = self.LockHeight
    
    local success, err = self:InitializeFlight()
    if not success then 
        self._wasMaintaining = false
        self._pendingTarget = nil
        return false, err 
    end
    
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        self.LockedHeight = hrp.Position.Y
        self._lastLockedHeight = hrp.Position.Y
    end
    
    self.IsMaintaining = true
    self._currentTarget = target
    
    self.MaintainThread = task.spawn(function()
        self:MaintainDistanceDirect(target)
    end)
    
    self:SaveState()
    self:UpdateUIState()
    return true, string.format("開始維持距離 (%.1f)", self.TargetDistance)
end

function DistanceMaintainSystem:StopMaintaining(keepState)
    self.IsMaintaining = false
    
    if not keepState then
        self._wasMaintaining = false
        self._pendingTarget = nil
    end
    
    if self.MaintainThread then
        task.cancel(self.MaintainThread)
        self.MaintainThread = nil
    end
    
    self:CompleteCleanup()
    self.NoClipSystem:DisableNoClip()
    self._currentTarget = nil
    self:UpdateUIState()
    return true, "停止距離維持"
end

-- ========== 功能控制 ==========
function DistanceMaintainSystem:ToggleHeightLock()
    self.LockHeight = not self.LockHeight
    if self.LockHeight then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            self.LockedHeight = hrp.Position.Y
            self._lastLockedHeight = hrp.Position.Y
        end
    end
    self:UpdateUIState()
    return self.LockHeight
end

function DistanceMaintainSystem:SetSpeed(speed)
    if speed < 1 or speed > 500 then return false end
    SpeedInputSystem.CurrentSpeed = speed
    self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(speed)
    self._lastSpeed = speed
    self:UpdateUIState()
    return true
end

function DistanceMaintainSystem:SetDistance(distance)
    if distance < 1 or distance > 3000 then return false end
    self.TargetDistance = distance
    self:UpdateUIState()
    return true
end

-- ========== 狀態管理 ==========
function DistanceMaintainSystem:SaveState()
    if not self.SystemActive then return end
    local state = {
        WasMaintaining = self._wasMaintaining,
        TargetUserId = self._pendingTarget and self._pendingTarget.UserId,
        TargetDistance = self.TargetDistance,
        Speed = SpeedInputSystem.CurrentSpeed,
        LockHeight = self.LockHeight,
        LockedHeight = self.LockedHeight,
        AutoNoClip = self.AutoNoClipEnabled,
        UIPosition = c00ltpframe and {X = c00ltpframe.Position.X.Scale, Y = c00ltpframe.Position.Y.Scale} or nil
    }
    PersistentStorage:SaveState(state)
end

function DistanceMaintainSystem:LoadState()
    local state = PersistentStorage:LoadState()
    if state then
        self._wasMaintaining = state.WasMaintaining or false
        self.TargetDistance = state.TargetDistance or 10
        self.LockHeight = state.LockHeight or false
        self.LockedHeight = state.LockedHeight or 0
        self.AutoNoClipEnabled = state.AutoNoClip
        SpeedInputSystem.CurrentSpeed = state.Speed or 8
        self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(SpeedInputSystem.CurrentSpeed)
        
        if state.TargetUserId then
            self._pendingTarget = Players:GetPlayerByUserId(state.TargetUserId)
        end
        
        if state.UIPosition and c00ltpframe then
            c00ltpframe.Position = UDim2.new(state.UIPosition.X, 0, state.UIPosition.Y, 0)
        end
        
        return true
    end
    return false
end

-- ========== 重生處理 ==========
function DistanceMaintainSystem:InitializeCharacterListeners()
    if self._characterAddedConnection then self._characterAddedConnection:Disconnect() end
    if self._characterRemovingConnection then self._characterRemovingConnection:Disconnect() end
    
    self._characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if not self.SystemActive then return end
        print("角色重生，恢復設定...")
        task.wait(0.5)
        
        self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(self._lastSpeed)
        self.LockHeight = self._lastHeightLock
        self.LockedHeight = self._lastLockedHeight
        
        if self._wasMaintaining and self._pendingTarget and self._autoReconnect then
            task.wait(1)
            self:StartMaintaining(self._pendingTarget)
        end
        
        self:UpdateUIState()
    end)
    
    self._characterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(function(character)
        if self.IsMaintaining then
            self._wasMaintaining = true
            self._pendingTarget = self._currentTarget
            self._lastSpeed = SpeedInputSystem.CurrentSpeed
            self._lastHeightLock = self.LockHeight
            
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then self._lastLockedHeight = hrp.Position.Y end
            
            self:SaveState()
        end
        self:CompleteCleanup(character)
    end)
end

