-- 跳過按鈕事件
SkipButton.MouseButton1Click:Connect(function()
    if not currentSelectedPlayer then
        createPlayerSelection()
        return
    end
    
    -- 跳過到下一玩家
    local allPlayers = Players:GetPlayers()
    local currentIndex = nil
    
    -- 找到當前選擇玩家的索引
    for i, player in ipairs(allPlayers) do
        if player == currentSelectedPlayer then
            currentIndex = i
            break
        end
    end
    
    if currentIndex then
        -- 找下一個非自己的玩家
        local nextPlayer = nil
        for i = currentIndex + 1, #allPlayers do
            if allPlayers[i] ~= LocalPlayer then
                nextPlayer = allPlayers[i]
                break
            end
        end
        
        -- 如果沒有找到，從頭開始找
        if not nextPlayer then
            for i, player in ipairs(allPlayers) do
                if player ~= LocalPlayer and player ~= currentSelectedPlayer then
                    nextPlayer = player
                    break
                end
            end
        end
        
        if nextPlayer then
            currentSelectedPlayer = nextPlayer
            updatePlayerInfo(nextPlayer)
        else
            warn("沒有其他玩家可以跳過")
        end
    end
end)

-- ==================== 自動更新距離 ====================
local distanceUpdateThread = task.spawn(function()
    while task.wait(0.5) do
        if c00ltpframe.Visible and not isMinimized then
            updateDistance()
        end
    end
end)

-- ==================== 玩家加入/離開處理 ====================
Players.PlayerAdded:Connect(function(player)
    if currentSelectedPlayer == nil then
        -- 如果有新玩家加入且當前未選擇玩家，自動選擇第一個其他玩家
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if currentSelectedPlayer == player then
        -- 如果當前選擇的玩家離開，選擇其他玩家
        local allPlayers = Players:GetPlayers()
        local newPlayer = nil
        
        for _, p in ipairs(allPlayers) do
            if p ~= LocalPlayer and p ~= player then
                newPlayer = p
                break
            end
        end
        
        currentSelectedPlayer = newPlayer
        updatePlayerInfo(newPlayer)
        
        -- 如果正在對該玩家維持距離，停止維持
        if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == player then
            DistanceMaintainSystem:StopMaintaining()
        end
    end
end)

-- 初始選擇一個玩家
local function initializePlayerSelection()
    local allPlayers = Players:GetPlayers()
    for _, player in ipairs(allPlayers) do
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
            break
        end
    end
    
    if not currentSelectedPlayer then
        warn("沒有其他玩家在遊戲中")
    end
end

