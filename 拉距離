function DistanceMaintainSystem:_createBodyMover(className, name, parent)
    if not parent then return nil end
    
    local existing = parent:FindFirstChild(name)
    if existing then
        existing:Destroy()
    end
    
    local mover = Instance.new(className)
    mover.Name = name
    return mover
end

function DistanceMaintainSystem:InitializeFlight()
    local character = LocalPlayer.Character
    if not character or not character:IsDescendantOf(game) then 
        return false, "角色無效" 
    end
    
    local hrp = character:WaitForChild("HumanoidRootPart", 2)
    if not hrp then 
        return false, "找不到角色根節點" 
    end
    
    self:CleanupFlight()
    
    -- 創建BodyVelocity用於水平移動
    self.BodyVelocity = self:_createBodyMover("BodyVelocity", "FlightVelocity", hrp)
    if not self.BodyVelocity then return false end
    
    self.BodyVelocity.MaxForce = Vector3.new(10000, 0, 10000) * self.MaxForceMultiplier
    self.BodyVelocity.P = 1500
    self.BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    
    -- 創建BodyPosition用於保持高度
    self.BodyPosition = self:_createBodyMover("BodyPosition", "FlightPosition", hrp)
    if not self.BodyPosition then return false end
    
    self.BodyPosition.MaxForce = Vector3.new(0, 10000, 0) * self.MaxForceMultiplier
    self.BodyPosition.P = 2000
    self.BodyPosition.Position = hrp.Position
    self.BodyPosition.D = 500
    
    -- 創建BodyGyro用於控制旋轉
    self.BodyGyro = self:_createBodyMover("BodyGyro", "FlightGyro", hrp)
    if not self.BodyGyro then return false end
    
    self.BodyGyro.MaxTorque = Vector3.new(10000, 10000, 10000) * self.MaxForceMultiplier
    self.BodyGyro.P = 1500
    self.BodyGyro.CFrame = hrp.CFrame
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = true
        
        local animate = character:FindFirstChild("Animate")
        if animate then
            animate.Disabled = true
        end
        
        humanoid.AutoRotate = false
        humanoid.AutoJumpEnabled = false
    end
    
    self.BodyVelocity.Parent = hrp
    self.BodyPosition.Parent = hrp
    self.BodyGyro.Parent = hrp
    
    self.MoveSpeed = self.SpeedSystem:GetAdjustedSpeed(self.SpeedSystem.CurrentSpeed)
    
    if self.AutoNoClipEnabled then
        local success = self.NoClipSystem:EnableNoClip(character)
        if not success then
            warn("穿牆模式啟用失敗")
        end
    end
    
    self._isInitialized = true
    self._smoothVelocity = Vector3.zero
    self._targetVelocity = Vector3.zero
    
    return true
end

function DistanceMaintainSystem:CleanupFlight()
    self._isInitialized = false
    self.IsMaintaining = false
    
    local character = LocalPlayer.Character
    
    if character and character:IsDescendantOf(game) then
        local velocity = character:FindFirstChild("FlightVelocity")
        if velocity then pcall(function() velocity:Destroy() end) end
        
        local position = character:FindFirstChild("FlightPosition")
        if position then pcall(function() position:Destroy() end) end
        
        local gyro = character:FindFirstChild("FlightGyro")
        if gyro then pcall(function() gyro:Destroy() end) end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            humanoid.AutoJumpEnabled = true
            
            local animate = character:FindFirstChild("Animate")
            if animate then
                animate.Disabled = false
            end
        end
    end
    
    if self.BodyVelocity then
        pcall(function() self.BodyVelocity:Destroy() end)
        self.BodyVelocity = nil
    end
    
    if self.BodyPosition then
        pcall(function() self.BodyPosition:Destroy() end)
        self.BodyPosition = nil
    end
    
    if self.BodyGyro then
        pcall(function() self.BodyGyro:Destroy() end)
        self.BodyGyro = nil
    end
    
    self.LastPosition = nil
    self.NoClipSystem:DisableNoClip()
end

function DistanceMaintainSystem:CalculateMaintainPosition(targetPosition, currentPosition)
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude
    
    if distance < 0.001 then
        return currentPosition + Vector3.new(0, self.HeightOffset, 0), distance
    end
    
    local direction = offset / distance
    local moveAmount = math.clamp(distance - self.TargetDistance, -self.MoveSpeed * 0.1, self.MoveSpeed * 0.1)
    local targetMaintainPos = currentPosition + direction * moveAmount
    
    if self.LockHeight then
        targetMaintainPos = Vector3.new(targetMaintainPos.X, self.LockedHeight, targetMaintainPos.Z)
    else
        targetMaintainPos = targetMaintainPos + Vector3.new(0, self.HeightOffset, 0)
    end
    
    return targetMaintainPos, distance
end

function DistanceMaintainSystem:FlyToMaintainPosition(targetPosition)
    local character = LocalPlayer.Character
    if not character or not character:IsDescendantOf(game) then return false end
    if not self.BodyVelocity or not self.BodyGyro or not self.BodyPosition then return false end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local currentPos = hrp.Position
    local maintainPos, currentDistance = self:CalculateMaintainPosition(targetPosition, currentPos)
    
    -- 水平移動
    local horizontalDirection = (Vector3.new(maintainPos.X, 0, maintainPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z))
    local horizontalDistance = horizontalDirection.Magnitude
    
    local targetSpeed
    if horizontalDistance < 1 then
        targetSpeed = Vector3.zero
    elseif horizontalDistance < 5 then
        local speedFactor = horizontalDistance / 5
        local horizontalDir = horizontalDirection.Unit
        targetSpeed = horizontalDir * self.MoveSpeed * speedFactor * 0.5
    else
        local horizontalDir = horizontalDirection.Unit
        targetSpeed = horizontalDir * self.MoveSpeed
    end
    
    self._smoothVelocity = self._smoothVelocity:Lerp(targetSpeed, self.SmoothFactor)
    
    if self.BodyVelocity then
        self.BodyVelocity.Velocity = Vector3.new(self._smoothVelocity.X, 0, self._smoothVelocity.Z)
    end
    
    -- 高度控制
    if self.BodyPosition then
        local targetHeight
        if self.LockHeight then
            targetHeight = self.LockedHeight
        else
            targetHeight = maintainPos.Y
        end
        
        local currentHeight = hrp.Position.Y
        local smoothHeight = currentHeight + (targetHeight - currentHeight) * 0.2
        self.BodyPosition.Position = Vector3.new(currentPos.X, smoothHeight, currentPos.Z)
    end
    
    -- 面向目標
    if horizontalDistance > 0.1 and self.BodyGyro then
        local lookDirection = (Vector3.new(targetPosition.X, 0, targetPosition.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Unit
        if lookDirection.Magnitude > 0.1 then
            local currentCFrame = hrp.CFrame
            local targetCFrame = CFrame.new(currentPos, currentPos + lookDirection)
            local smoothedCFrame = currentCFrame:Lerp(targetCFrame, self.RotationSmoothness)
            self.BodyGyro.CFrame = smoothedCFrame
        end
    end
    
    return true, currentDistance
end

function DistanceMaintainSystem:MaintainDistanceDirect(target)
    if not self.Enabled or not self.IsMaintaining then return end
    
    local lastUpdate = tick()
    local UPDATE_INTERVAL = 0.016
    local errorCount = 0
    local MAX_ERRORS = 5
    
    while self.IsMaintaining and task.wait(UPDATE_INTERVAL) do
        local success, err = pcall(function()
            if not target or not target:IsDescendantOf(game) then 
                self:StopMaintaining()
                return 
            end
            
            if not target.Character or not target.Character:IsDescendantOf(game) then 
                self:StopMaintaining()
                return 
            end
            
            if not LocalPlayer.Character or not LocalPlayer.Character:IsDescendantOf(game) then 
                return 
            end
            
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if not targetRoot or not myRoot then return end
            
            local targetPos = targetRoot.Position
            local success, currentDistance = self:FlyToMaintainPosition(targetPos)
            
            if success then
                self.LastPosition = myRoot.Position
                self:UpdateUIDistance(currentDistance)
            end
        end)
        
        if not success then
            errorCount = errorCount + 1
            warn("距離維持錯誤 #" .. errorCount .. ": " .. tostring(err))
            
            if errorCount >= MAX_ERRORS then
                warn("達到最大錯誤次數，自動停止距離維持")
                self:StopMaintaining()
                break
            end
            
            task.wait(0.1)
        else
            errorCount = 0
        end
        
        local now = tick()
        if now - lastUpdate >= 0.16 then
            lastUpdate = now
        end
    end
    
    self:CleanupFlight()
end

function DistanceMaintainSystem:StartMaintaining(target)
    if self.IsMaintaining then
        self:StopMaintaining()
        task.wait(0.1)
    end
    
    if not target or not target:IsDescendantOf(game) then
        return false, "目標無效"
    end
    
    if target == LocalPlayer then
        return false, "無法對自己維持距離"
    end
    
    self._pendingTarget = target
    self._wasMaintaining = true
    self._lastTargetDistance = self.TargetDistance
    self._lastSpeed = SpeedInputSystem.CurrentSpeed
    self._lastHeightLock = self.LockHeight
    
    local success, err = self:InitializeFlight()
    if not success then
        self._wasMaintaining = false
        self._pendingTarget = nil
        return false, err or "飛行系統初始化失敗"
    end
    
    local character = LocalPlayer.Character
    if character and character:IsDescendantOf(game) then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            self.LockedHeight = hrp.Position.Y
            self._lastLockedHeight = hrp.Position.Y
        end
    end
    
    self.IsMaintaining = true
    self._currentTarget = target
    
    self.MaintainThread = task.spawn(function()
        local maintainSuccess, maintainErr = pcall(function()
            self:MaintainDistanceDirect(target)
        end)
        
        if not maintainSuccess then
            warn("距離維持錯誤: " .. tostring(maintainErr))
            self:CleanupFlight()
            self.IsMaintaining = false
            self._currentTarget = nil
        end
    end)
    
    self:SaveState()
    self:UpdateUIState()
    
    local lockText = self.LockHeight and " (高度鎖定)" or ""
    return true, string.format("開始維持距離 (%.1f)%s", self.TargetDistance, lockText)
end

function DistanceMaintainSystem:StopMaintaining(keepState)
    self.IsMaintaining = false
    
    if not keepState then
        self._wasMaintaining = false
        self._pendingTarget = nil
    end
    
    if self.MaintainThread then
        task.cancel(self.MaintainThread)
        self.MaintainThread = nil
    end
    
    self:CleanupFlight()
    self._currentTarget = nil
    self:UpdateUIState()
    
    return true, "停止距離維持"
end

function DistanceMaintainSystem:ToggleHeightLock()
    self.LockHeight = not self.LockHeight
    
    if self.LockHeight then
        local character = LocalPlayer.Character
        if character and character:IsDescendantOf(game) then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                self.LockedHeight = hrp.Position.Y
                self._lastLockedHeight = hrp.Position.Y
            end
        end
        return true, "高度鎖定已啟用"
    else
        return true, "高度鎖定已關閉"
    end
end

function DistanceMaintainSystem:SetSpeedDirectly(speed)
    if speed < SpeedInputSystem.MinSafeSpeed or speed > SpeedInputSystem.MaxSafeSpeed then
        return false, "速度超出範圍"
    end
    
    SpeedInputSystem.CurrentSpeed = speed
    self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(speed)
    self._lastSpeed = speed
    return true, string.format("速度已設為: %d", speed)
end

function DistanceMaintainSystem:SetDistanceDirectly(distance)
    if distance < self.MinDistance or distance > self.MaxDistance then
        return false, string.format("距離必須在 %.1f 到 %.1f 之間", self.MinDistance, self.MaxDistance)
    end
    
    self.TargetDistance = distance
    self._lastTargetDistance = distance
    return true, string.format("維持距離已設為: %.1f", distance)
end

-- ==================== 重生處理 ====================
function DistanceMaintainSystem:InitializeCharacterListeners()
    if self._characterAddedConnection then
        self._characterAddedConnection:Disconnect()
    end
    
    if self._characterRemovingConnection then
        self._characterRemovingConnection:Disconnect()
    end
    
    self._characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        print("角色重生，等待初始化...")
        task.wait(0.5)
        
        self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(self._lastSpeed)
        self.LockHeight = self._lastHeightLock
        self.LockedHeight = self._lastLockedHeight
        
        if self._wasMaintaining and self._pendingTarget and self._autoReconnect then
            print("嘗試恢復距離維持，目標:", self._pendingTarget.Name)
            task.wait(1)
            
            local success, err = self:StartMaintaining(self._pendingTarget)
            if success then
                print("距離維持恢復成功")
            else
                warn("距離維持恢復失敗:", err)
            end
        end
        
        self:UpdateUIState()
    end)
    
    self._characterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(function(character)
        print("角色即將移除，保存狀態...")
        
        if self.IsMaintaining then
            self._wasMaintaining = true
            self._pendingTarget = self._currentTarget
            self._lastTargetDistance = self.TargetDistance
            self._lastSpeed = SpeedInputSystem.CurrentSpeed
            self._lastHeightLock = self.LockHeight
            
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then
                self._lastLockedHeight = hrp.Position.Y
            end
            
            self:SaveState()
        end
        
        self:CleanupFlight()
    end)
end

function DistanceMaintainSystem:SaveState()
    local state = {
        WasMaintaining = self._wasMaintaining,
        TargetUserId = self._pendingTarget and self._pendingTarget.UserId or nil,
        TargetDistance = self.TargetDistance,
        Speed = SpeedInputSystem.CurrentSpeed,
        LockHeight = self.LockHeight,
        LockedHeight = self.LockedHeight,
        AutoNoClip = self.AutoNoClipEnabled,
        UseDirectPath = self.UseDirectPath
    }
    PersistentStorage:SaveState(state)
end

function DistanceMaintainSystem:LoadState()
    local state = PersistentStorage:LoadState()
    if state then
        self._wasMaintaining = state.WasMaintaining or false
        self.TargetDistance = state.TargetDistance or 10
        self.LockHeight = state.LockHeight or false
        self.LockedHeight = state.LockedHeight or 0
        self.AutoNoClipEnabled = state.AutoNoClip
        self.UseDirectPath = state.UseDirectPath
        
        SpeedInputSystem.CurrentSpeed = state.Speed or 8
        self.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(SpeedInputSystem.CurrentSpeed)
        
        if state.TargetUserId then
            local target = Players:GetPlayerByUserId(state.TargetUserId)
            if target then
                self._pendingTarget = target
            end
        end
        
        return true
    end
    return false
end

