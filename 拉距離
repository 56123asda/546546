        updateSpeedDisplay()
        SpeedInputBox.PlaceholderText = "已設定"
    else
        local originalText = SpeedInputBox.Text
        SpeedInputBox.Text = ""
        SpeedInputBox.PlaceholderText = message
        task.wait(1.5)
        SpeedInputBox.Text = originalText
        SpeedInputBox.PlaceholderText = "1-500"
    end
end)

