coreGui.ChildRemoved:Connect(function(child)
    if child == c00ltpgui and DistanceMaintainSystem.SystemActive then
        task.wait(0.1)
        c00ltpgui.Parent = coreGui
        print("UI已重新添加到CoreGui")
    end
end)

