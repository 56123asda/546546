-- ==================== UI 事件綁定 ====================
MinimizeButton.MouseButton1Click:Connect(toggleMinimize)

CloseButton.MouseButton1Click:Connect(function()
    DistanceMaintainSystem:StopMaintaining()
    c00ltpframe.Visible = false
end)

PlayersListButton.MouseButton1Click:Connect(function()
    createPlayerSelection()
end)

MaintainButton.MouseButton1Click:Connect(function()
    if not currentSelectedPlayer then
        createPlayerSelection()
        return
    end
    
    if DistanceMaintainSystem.IsMaintaining and DistanceMaintainSystem._currentTarget == currentSelectedPlayer then
        DistanceMaintainSystem:StopMaintaining()
    else
        DistanceMaintainSystem:StartMaintaining(currentSelectedPlayer)
    end
    
    DistanceMaintainSystem:UpdateUIState()
    updatePlayerInfo(currentSelectedPlayer)
end)

SkipButton.MouseButton1Click:Connect(function()
    if not currentSelectedPlayer then
        createPlayerSelection()
        return
    end
    
    local allPlayers = Players:GetPlayers()
    local currentIndex = nil
    
    for i, player in ipairs(allPlayers) do
        if player == currentSelectedPlayer then
            currentIndex = i
            break
        end
    end
    
    if currentIndex then
        local nextPlayer = nil
        for i = currentIndex + 1, #allPlayers do
            if allPlayers[i] ~= LocalPlayer then
                nextPlayer = allPlayers[i]
                break
            end
        end
        
        if not nextPlayer then
            for i, player in ipairs(allPlayers) do
                if player ~= LocalPlayer and player ~= currentSelectedPlayer then
                    nextPlayer = player
                    break
                end
            end
        end
        
        if nextPlayer then
            currentSelectedPlayer = nextPlayer
            updatePlayerInfo(nextPlayer)
        end
    end
end)

AutoNoClipButton.MouseButton1Click:Connect(function()
    DistanceMaintainSystem.AutoNoClipEnabled = not DistanceMaintainSystem.AutoNoClipEnabled
    DistanceMaintainSystem:UpdateUIState()
end)

HeightLockButton.MouseButton1Click:Connect(function()
    DistanceMaintainSystem:ToggleHeightLock()
    DistanceMaintainSystem:UpdateUIState()
    updateDistance()
end)

SetSpeedButton.MouseButton1Click:Connect(function()
    local inputText = SpeedInputBox.Text
    local success, message = SpeedInputSystem:SetSpeedByInput(inputText)
    
    if success then
        DistanceMaintainSystem.MoveSpeed = SpeedInputSystem:GetAdjustedSpeed(SpeedInputSystem.CurrentSpeed)
        DistanceMaintainSystem._lastSpeed = SpeedInputSystem.CurrentSpeed
        SpeedInputBox.Text = tostring(SpeedInputSystem.CurrentSpeed)
        SpeedInputBox.PlaceholderText = "速度已設定"
    else
        SpeedInputBox.Text = ""
        SpeedInputBox.PlaceholderText = message
        task.wait(1.5)
        SpeedInputBox.Text = tostring(SpeedInputSystem.CurrentSpeed)
        SpeedInputBox.PlaceholderText = "1-500"
    end
end)

SetDistanceButton.MouseButton1Click:Connect(function()
    local inputText = DistanceInputBox.Text
    local distanceNumber = tonumber(inputText)
    
    if not distanceNumber then
        DistanceInputBox.Text = ""
        DistanceInputBox.PlaceholderText = "請輸入數字"
        task.wait(1.5)
        DistanceInputBox.Text = string.format("%.1f", DistanceMaintainSystem.TargetDistance)
        DistanceInputBox.PlaceholderText = "1-3000"
        return
    end
    
    local success, message = DistanceMaintainSystem:SetDistanceDirectly(distanceNumber)
    if success then
        DistanceInputBox.Text = string.format("%.1f", DistanceMaintainSystem.TargetDistance)
        DistanceInputBox.PlaceholderText = "距離已設定"
        updateDistance()
    else
        DistanceInputBox.Text = ""
        DistanceInputBox.PlaceholderText = message
        task.wait(1.5)
        DistanceInputBox.Text = string.format("%.1f", DistanceMaintainSystem.TargetDistance)
        DistanceInputBox.PlaceholderText = "1-3000"
    end
end)

