    for _, v in pairs(playerHits) do
        table.insert(bladehits, v)
    end
    
    if #bladehits == 0 then return end
    
    local args = {
        [1] = nil,
        [2] = {},
        [4] = "078da341"
    }
    
    for r, v in pairs(bladehits) do
