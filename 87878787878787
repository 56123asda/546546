            FlashAttackModule:Start()
        elseif msg == "/flash off" or msg == "/flash stop" then
            FlashAttackModule:Stop()
        elseif msg == "/flash status" then
            print("当前状态: " .. (FlashAttackModule:IsEnabled() and "已开启" or "已关闭"))
            print("攻击距离: " .. Config.AttackDistance)
            print("攻击怪物: " .. (Config.AttackMobs and "开启" or "关闭"))
            print("攻击玩家: " .. (Config.AttackPlayers and "开启" or "关闭"))
        elseif msg:find("/flash distance") then
            local distance = tonumber(msg:match("/flash distance%s+(%d+)"))
            if distance and distance >= 100 and distance <= 10000 then
                FlashAttackModule:SetConfig("AttackDistance", distance)
                print("攻击距离已设置为: " .. distance)
            else
                print("请输入有效的距离 (100-10000)")
            end
        elseif msg:find("/flash mobs") then
            local state = msg:match("/flash mobs%s+(%a+)")
            if state == "on" then
                FlashAttackModule:SetConfig("AttackMobs", true)
                print("攻击怪物: 开启")
            elseif state == "off" then
                FlashAttackModule:SetConfig("AttackMobs", false)
                print("攻击怪物: 关闭")
            end
        elseif msg:find("/flash players") then
            local state = msg:match("/flash players%s+(%a+)")
            if state == "on" then
                FlashAttackModule:SetConfig("AttackPlayers", true)
                print("攻击玩家: 开启")
            elseif state == "off" then
                FlashAttackModule:SetConfig("AttackPlayers", false)
                print("攻击玩家: 关闭")
            end
        end
    end)
end

