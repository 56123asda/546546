            args[1] = v.Head
        end
        args[2][r] = {
            [1] = v,
            [2] = v.HumanoidRootPart
        }
    end
    RegisterHit:FireServer(unpack(args))
end

function FlashAttackModule:Start()
    if FlashAttackEnabled then return end
    
    FlashAttackEnabled = true
    
    lastScanTime = 0
    cachedBladeHits = {}
    lastAttackTime = 0
    
    fastAttackInstance = FastAttack.new()
    
    -- 根據攻擊速度選擇合適的循環
    if Config.AttackCooldown <= 0.01 then
        -- 如果攻擊間隔小於0.01秒，使用RenderStepped
        Config.UltraFastMode = true
        print("啟用極速攻擊模式 (RenderStepped)")
        
        attackConnection = RunService.RenderStepped:Connect(function()
            local currentTime = tick()
            local attackCooldown = Config.AttackCooldown
            
            if currentTime - lastAttackTime >= attackCooldown then
                if fastAttackInstance then
                    fastAttackInstance:Attack()
                end
                AttackAll()
                Funcs:Attack()
                lastAttackTime = currentTime
            end
        end)
    else
        -- 普通速度使用Heartbeat
        Config.UltraFastMode = false
        print("啟用普通攻擊模式 (Heartbeat)")
        
        attackConnection = RunService.Heartbeat:Connect(function()
            local currentTime = tick()
            local attackCooldown = Config.AttackCooldown
            
            if currentTime - lastAttackTime >= attackCooldown then
                if fastAttackInstance then
                    fastAttackInstance:Attack()
                end
                AttackAll()
                Funcs:Attack()
                lastAttackTime = currentTime
            end
        end)
    end
    
    print("========================================")
    print("Flash Attack 已開啟")
    print("攻擊冷卻: " .. Config.AttackCooldown .. "秒")
    print("攻擊頻率: " .. (1 / Config.AttackCooldown) .. "次/秒")
    print("模式: " .. (Config.UltraFastMode and "極速(RenderStepped)" or "普通(Heartbeat)"))
    print("========================================")
end

function FlashAttackModule:Stop()
    if not FlashAttackEnabled then return end
    
    FlashAttackEnabled = false
    
    if attackConnection then
        attackConnection:Disconnect()
        attackConnection = nil
    end
    
    if fastAttackInstance then
        for _, conn in ipairs(fastAttackInstance.Connections) do
            pcall(function() conn:Disconnect() end)
        end
        fastAttackInstance = nil
    end
    
    cachedBladeHits = {}
    
    print("========================================")
    print("Flash Attack 已關閉")
    print("========================================")
end

function FlashAttackModule:SetState(state)
    if state then
        self:Start()
    else
        self:Stop()
    end
end

function FlashAttackModule:IsEnabled()
    return FlashAttackEnabled
end

function FlashAttackModule:SetConfig(key, value)
    if key == "AttackDistance" then
        Config.AttackDistance = value
        print("攻擊距離更新: " .. value)
    elseif key == "AttackMobs" then
        Config.AttackMobs = value
        print("攻擊怪物更新: " .. (value and "開啟" or "關閉"))
    elseif key == "AttackPlayers" then
        Config.AttackPlayers = value
        print("攻擊玩家更新: " .. (value and "開啟" or "關閉"))
    elseif key == "AttackCooldown" then
        -- 確保不小於最小間隔
        if value < Config.AttackCooldownMin then
            value = Config.AttackCooldownMin
            print("警告：攻擊間隔已調整為最小值" .. Config.AttackCooldownMin .. "秒")
        end
        Config.AttackCooldown = value
        print("攻擊冷卻更新: " .. value .. "秒 (" .. (1/value) .. "次/秒)")
        
        -- 如果正在運行且速度改變，重新調整模式
        if FlashAttackEnabled and attackConnection then
            local isUltraFast = value <= 0.01
            if Config.UltraFastMode ~= isUltraFast then
                print("攻擊速度改變，重新啟動攻擊循環...")
                self:Stop()
                task.wait(0.05)
                self:Start()
            end
        end
    end
end

