-- =====================================================
-- 玩家列表管理
-- =====================================================

local playerList = {}  -- 儲存玩家名稱列表
local playerMap = {}   -- 儲存玩家名稱對應的物件
local selectedPlayer = nil
local playerDropdown = nil
local aimbotButton = nil  -- 自瞄按鈕

-- 刷新玩家列表
local function RefreshPlayerList()
    WindUI:Notify({ 
        Title = "玩家列表", 
        Content = "正在重新載入...", 
        Duration = 1 
    })

    local newPlayerList = {}
    local newPlayerMap = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(newPlayerList, player.Name)
            newPlayerMap[player.Name] = player
        end
    end

    playerList = newPlayerList
    playerMap = newPlayerMap

    -- 刷新下拉選單
    if playerDropdown then
        if #playerList > 0 then
            playerDropdown:Refresh(playerList)
            pcall(function()
                playerDropdown:SetValue("請選擇玩家")
            end)
        else
            playerDropdown:Refresh({"目前沒有其他玩家"})
            pcall(function()
                playerDropdown:SetValue("目前沒有其他玩家")
            end)
        end
    end

    WindUI:Notify({ 
        Title = "玩家列表", 
        Content = #playerList > 0 and 
            ("重新載入成功，找到 " .. #playerList .. " 位玩家") 
            or "目前沒有其他玩家在線", 
        Duration = 2 
    })
end

-- 初始化玩家列表
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        table.insert(playerList, player.Name)
        playerMap[player.Name] = player
    end
end

-- =====================================================
-- 自瞄核心功能
-- =====================================================

local SimpleAimbot = {
    Enabled = false,           -- 功能開關
}

-- 檢查目標是否存活
local function IsTargetAlive(character)
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

-- 自瞄主循環
RunService.RenderStepped:Connect(function()
    if not SimpleAimbot.Enabled then return end
    
    -- 檢查是否有選中的玩家
    if not selectedPlayer then
        SimpleAimbot.Enabled = false
        if aimbotButton then
            aimbotButton:SetTitle("開啟自瞄")
        end
        WindUI:Notify({
            Title = "自瞄功能",
            Content = "請先選擇目標玩家",
            Duration = 2,
            Icon = "alert-triangle"
        })
        return
    end
    
    -- 檢查目標是否有效
    local character = selectedPlayer.Character
    if not character then return end
    
    if not IsTargetAlive(character) then return end
    
    -- 瞄準頭部
    local targetPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    
    -- 獲取當前相機方向
    local currentCFrame = Camera.CFrame
    local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
    
    -- 平滑移動
    local smoothness = 0.3
    Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothness)
end)

-- 切換自瞄開關
local function ToggleSimpleAimbot()
    SimpleAimbot.Enabled = not SimpleAimbot.Enabled
    
    if SimpleAimbot.Enabled then
        -- 檢查是否有選中的玩家
        if not selectedPlayer then
            SimpleAimbot.Enabled = false
            WindUI:Notify({
                Title = "自瞄功能",
                Content = "請先選擇目標玩家",
                Duration = 2,
                Icon = "alert-triangle"
            })
            return
        end
        
        -- 更新按鈕文字
        if aimbotButton then
            aimbotButton:SetTitle("關閉自瞄")
        end
        
        WindUI:Notify({
            Title = "自瞄功能",
            Content = "已鎖定: " .. selectedPlayer.Name,
            Duration = 2,
            Icon = "target"
        })
    else
        -- 更新按鈕文字
        if aimbotButton then
            aimbotButton:SetTitle("開啟自瞄")
        end
        
        WindUI:Notify({
            Title = "自瞄功能",
            Content = "已關閉",
            Duration = 1,
            Icon = "target"
        })
    end
end

-- 當角色重生時關閉自瞄
LocalPlayer.CharacterAdded:Connect(function()
    if SimpleAimbot.Enabled then
        SimpleAimbot.Enabled = false
        if aimbotButton then
            aimbotButton:SetTitle("開啟自瞄")
        end
    end
end)

-- 當目標離開時自動關閉
Players.PlayerRemoving:Connect(function(player)
    if SimpleAimbot.Enabled and selectedPlayer and player == selectedPlayer then
        SimpleAimbot.Enabled = false
        if aimbotButton then
            aimbotButton:SetTitle("開啟自瞄")
        end
        WindUI:Notify({
            Title = "自瞄功能",
            Content = "目標已離開，自動關閉",
            Duration = 2,
            Icon = "info"
        })
        selectedPlayer = nil
    end
end)

