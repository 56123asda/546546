-- 創建 UI 窗口
-- =====================================================

local Window = WindUI:CreateWindow({
    Title = "小傑腳本 - 自瞄功能",
    Icon = "rbxassetid://6031280882",
    Author = "小傑",
    Folder = "WindUI",
    Size = UDim2.fromOffset(400, 320),
    Transparent = false,
    Theme = "Light",
    ScrollBarEnabled = true,
})

-- N 鍵開關 UI
Window:SetToggleKey(Enum.KeyCode.N)

-- 創建標籤頁
local MainTab = Window:Tab({ Title = "自瞄設定", Icon = "target" })

-- =====================================================
-- 玩家選擇區域
-- =====================================================

-- 刷新按鈕
MainTab:Button({
    Title = "🔄 重新載入玩家列表",
    Callback = RefreshPlayerList
})

-- 玩家選擇下拉選單
if #playerList > 0 then
    playerDropdown = MainTab:Dropdown({
        Title = "選擇目標玩家",
        Values = playerList,
        Value = "請選擇玩家",
        Callback = function(selected)
            if selected ~= "請選擇玩家" and selected ~= "目前沒有其他玩家" then
                selectedPlayer = playerMap[selected]
                
                -- 如果自瞄開啟時切換目標，提示用戶
                if SimpleAimbot.Enabled then
                    WindUI:Notify({ 
                        Title = "提示", 
                        Content = "已切換目標至: " .. selected,
                        Duration = 2 
                    })
                end
            else
                selectedPlayer = nil
                
                -- 如果自瞄開啟時取消選擇，自動關閉
                if SimpleAimbot.Enabled then
                    SimpleAimbot.Enabled = false
                    if aimbotButton then
                        aimbotButton:SetTitle("開啟自瞄")
                    end
                    WindUI:Notify({
                        Title = "自瞄功能",
                        Content = "目標已取消，自動關閉",
                        Duration = 2,
                        Icon = "info"
                    })
                end
            end
        end
    })
else
    playerDropdown = MainTab:Dropdown({
        Title = "選擇目標玩家",
        Values = {"目前沒有其他玩家"},
        Value = "目前沒有其他玩家",
        Callback = function(selected)
            selectedPlayer = nil
        end
    })
end

MainTab:Divider()

-- =====================================================
-- 自瞄按鈕區域
-- =====================================================

-- 自瞄按鈕（取代原來的 Toggle）
aimbotButton = MainTab:Button({
    Title = "開啟自瞄",
