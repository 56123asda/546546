-- V4覺醒函數
local function callV4Awakening()
    local success, result = pcall(function()
        local Backpack = player:FindFirstChild("Backpack")
        if not Backpack then return false, "無背包" end
        
        local Awakening = Backpack:FindFirstChild("Awakening")
        if not Awakening then return false, "無Awakening技能" end
        
        local RemoteFunc = Awakening:FindFirstChild("RemoteFunction")
        if not RemoteFunc then return false, "無RemoteFunction" end
        
        return RemoteFunc:InvokeServer(true)
    end)
    
    return success, result
end

-- 初始化V4控制
local function setupV4Control()
    showNotification("🔥 正在初始化V4控制...", Color3.fromRGB(255, 165, 0), 1)
    
    local success, result = pcall(function()
        local Backpack = player:FindFirstChild("Backpack")
        local hasV4 = false
        local v4Status = "未檢測"
        
        if Backpack then
            local Awakening = Backpack:FindFirstChild("Awakening")
            if Awakening then
                hasV4 = true
                v4Status = "已檢測到Awakening技能"
            else
                v4Status = "未找到Awakening技能"
            end
        else
            v4Status = "背包不存在"
        end
        
        print("🎮 V4狀態: " .. v4Status)
        
        return {
            hasV4 = hasV4,
            v4Status = v4Status,
            start = function()
                if not hasV4 then
                    showNotification("❌ V4不可用: " .. v4Status, Color3.fromRGB(255, 0, 0), 2)
                    return false
                end
                
                isV4ControlOn = true
                
                if v4Task then
                    task.cancel(v4Task)
                end
                
                v4Task = task.spawn(function()
                    while isV4ControlOn do
                        local success, result = callV4Awakening()
                        if success then
                            print("✅ V4調用成功")
                        else
                            print("❌ V4調用失敗:", result)
                        end
                        task.wait(1)
                    end
                end)
                
                return true
            end,
            stop = function()
                isV4ControlOn = false
                
                if v4Task then
                    task.cancel(v4Task)
                    v4Task = nil
                end
            end,
            test = function()
                if not hasV4 then
                    showNotification("❌ V4不可用: " .. v4Status, Color3.fromRGB(255, 0, 0), 2)
                    return false, "V4不可用"
                end
                
                local success, result = callV4Awakening()
                if success then
                    showNotification("✅ V4測試成功", Color3.fromRGB(0, 180, 0), 2)
                    return true, "成功"
                else
                    showNotification("❌ V4測試失敗: " .. (result or "未知錯誤"), Color3.fromRGB(255, 0, 0), 2)
                    return false, result
                end
            end
        }
    end)
    
    if success and result then
        local v4Info = result
        showNotification("✅ V4控制初始化完成\n狀態: " .. v4Info.v4Status, Color3.fromRGB(0, 180, 0), 2)
        print("🎉 V4控制初始化成功: " .. v4Info.v4Status)
        return result
    else
        local errMsg = result or "未知錯誤"
        showNotification("⚠️ V4控制初始化失敗: " .. errMsg, Color3.fromRGB(255, 0, 0), 2)
        print("❌ V4控制初始化失敗: " .. errMsg)
        return nil
    end
end

