-- 更新玩家資訊顯示
local function updatePlayerInfo(player)
    if player then
        PlayerName.Text = player.Name
        PlayerIDs.Text = string.format("ID: %d", player.UserId)
        
        -- 獲取玩家頭像
        local success, result = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        
        if success and result then
            PlayerProfiles.Image = result
        else
            PlayerProfiles.Image = "rbxassetid://12222223187"
        end
        
        -- 更新追蹤按鈕狀態
        if FlyingTrackSystem.IsTracking and FlyingTrackSystem._currentTarget == player then
            TrackButton.Image = "rbxassetid://7072725343" -- 停止圖標
        else
            TrackButton.Image = "rbxassetid://7072725342" -- 追蹤圖標
        end
    else
        PlayerName.Text = "請選擇玩家"
        PlayerIDs.Text = "ID: -"
        PlayerFar.Text = "距離: -"
        PlayerProfiles.Image = "rbxassetid://12222223187"
    end
end

-- 更新距離顯示
local function updateDistance()
    if not currentSelectedPlayer then 
        PlayerFar.Text = "距離: -"
        return 
    end
    
    local targetChar = currentSelectedPlayer.Character
    local localChar = LocalPlayer.Character
    
    if targetChar and localChar then
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local localRoot = localChar:FindFirstChild("HumanoidRootPart")
        
        if targetRoot and localRoot then
            local distance = (targetRoot.Position - localRoot.Position).Magnitude
            PlayerFar.Text = string.format("距離: %d", math.floor(distance + 0.5))
        else
            PlayerFar.Text = "距離: -"
        end
    else
        PlayerFar.Text = "距離: -"
    end
end

