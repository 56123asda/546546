-- ==================== 立即響應的主腳本邏輯 ====================
local function createMainScript()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local StarterGui = game:GetService("StarterGui")
    local RunService = game:GetService("RunService")
    
    local player = Players.LocalPlayer
    
    local frame = c00ltpframe
    local skipButton = SkipButton
    local closeButton = CloseButton
    local trackButton = TrackButton
    local settingsButton = SettingsButton
    local autoNoClipButton = AutoNoClipButton
    local directPathButton = DirectPathButton
    local minimizeButton = MinimizeButton
    
    local playerName = PlayerName
    local playerIDs = PlayerIDs
    local playerFar = PlayerFar
    local title = Title
    local profileImage = PlayerProfiles
    
    local minimizedFrame = MinimizedFrame
    local expandButton = ExpandButton
    
    local controlFrame = ControlFrame
    local closeSettingsButton = CloseSettingsButton
    
    local trackSpeedLabel = TrackSpeedLabel
    local trackSpeedSlider = TrackSpeedSlider
    local trackSpeedValue = TrackSpeedValue
    local trackSpeedMinus = TrackSpeedMinus
    local trackSpeedPlus = TrackSpeedPlus
    
    local currentTarget = nil
    local playerList = {}
    local isTracking = false
    local isMinimized = false
    
    local TRACK_HEIGHT = 2 -- 固定的追蹤高度
    
    local clickSound = Instance.new("Sound")
    clickSound.SoundId = "rbxassetid://12221967"
    clickSound.Volume = 1
    clickSound.Parent = frame
    
    -- 即時更新變量
    local lastDistanceUpdate = 0
    local profileCache = {}
    
    -- 立即載入頭像（不延遲）
    local function loadPlayerThumbnail(targetPlayer)
        if not targetPlayer then
            return "rbxassetid://12222223187"
        end
        
        local userId = targetPlayer.UserId
        
        if profileCache[userId] then
            return profileCache[userId]
        end
        
        -- 立即返回預設頭像
        profileCache[userId] = "rbxassetid://12222223187"
        
        -- 後台異步載入真實頭像
        task.spawn(function()
            local success, result = pcall(function()
                return Players:GetUserThumbnailAsync(
                    userId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size420x420
                )
            end)
            
            if success and result and result ~= "" then
                profileCache[userId] = result
                
                -- 如果當前玩家還是同一個，立即更新
                if currentTarget and currentTarget.UserId == userId then
                    pcall(function()
                        profileImage.Image = result
                    end)
                end
            end
        end)
        
        return profileCache[userId]
    end
    
    local function playClick()
        if clickSound then
            clickSound:Play()
        end
    end
    
    local function showFeedback(feedbackTitle, message, isError)
        if not StarterGui then return end
        
        local icon = isError and "rbxassetid://6031094679" or "rbxassetid://6031094668"
        
        StarterGui:SetCore("SendNotification", {
            Title = feedbackTitle,
            Text = message,
            Duration = isError and 3 or 2,
            Icon = icon
        })
    end
    
    local function updateAutoNoClipButton()
        if FlyingTrackSystem.AutoNoClipEnabled then
            autoNoClipButton.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
            autoNoClipButton.Text = "追蹤穿牆: ✓"
        else
            autoNoClipButton.BackgroundColor3 = Color3.fromRGB(255, 120, 60)
            autoNoClipButton.Text = "追蹤穿牆: ✗"
        end
    end
    
    local function updateTrackSpeedDisplay()
        local currentSpeed = math.floor(FlyingTrackSystem.TrackSpeed)
        trackSpeedValue.Text = string.format("%d 速度", currentSpeed)
        
        local minSpeed = FlyingTrackSystem.MinSpeed
        local maxSpeed = FlyingTrackSystem.MaxSpeed
        local fillPercent = (FlyingTrackSystem.TrackSpeed - minSpeed) / (maxSpeed - minSpeed)
        local fillBars = math.floor(fillPercent * 10)
        trackSpeedSlider.Text = string.rep("█", fillBars) .. string.rep("░", 10 - fillBars)
    end
    
    local function adjustTrackSpeed(amount)
        local oldSpeed = FlyingTrackSystem.TrackSpeed
        local newSpeed = FlyingTrackSystem:AdjustSpeed(amount)
        
        updateTrackSpeedDisplay()
        
        playClick()
        
        local statusText = ""
        if isTracking then
            statusText = "\n正在追蹤中，速度已更新"
        end
        
        showFeedback("速度已調整", 
            string.format("速度: %d → %d%s", 
                math.floor(oldSpeed), math.floor(newSpeed),
                statusText))
    end
    
    local function startFlyingTrack()
        if game:GetService("NetworkClient") and not game:GetService("NetworkClient").ClientReplicator then
            showFeedback("錯誤", "網絡連接不穩定", true)
            return false
        end
        
        if not currentTarget or not currentTarget.Character then
            showFeedback("錯誤", "請先選擇一個玩家", true)
            return false
        end
        
        if not player.Character then
            showFeedback("錯誤", "您的角色不存在", true)
            return false
        end
        
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        
        if not myRoot or not targetRoot then
            showFeedback("錯誤", "無法找到角色位置", true)
            return false
        end
        
        isTracking = true
        trackButton.ImageTransparency = 0.3
        
        local modeText = FlyingTrackSystem.UseDirectPath and "直線追蹤" or "正常追蹤"
        local currentSpeed = math.floor(FlyingTrackSystem.TrackSpeed)
        local noClipText = FlyingTrackSystem.AutoNoClipEnabled and " (自動穿牆)" or ""
        
        showFeedback("開始高速追蹤！", 
            "正在追蹤 " .. currentTarget.Name .. 
            "\n速度：" .. currentSpeed .. 
            "\n模式：" .. modeText .. noClipText)
        
        local success, message = FlyingTrackSystem:StartTracking(currentTarget, TRACK_HEIGHT)
        
        if not success then
            isTracking = false
            trackButton.ImageTransparency = 0
            showFeedback("追蹤失敗", message, true)
            return false
        end
        
        playerFar.Text = "高速追蹤中..."
        playerName.Text = "追蹤中: " .. currentTarget.Name
        
        if FlyingTrackSystem.AutoNoClipEnabled then
            playerName.Text = playerName.Text .. " (穿牆中)"
        end
        
        return true
    end
    
    local function stopFlyingTrack()
        isTracking = false
        if trackButton then
            trackButton.ImageTransparency = 0
        end
        
        FlyingTrackSystem:StopTracking()
        
        if currentTarget then
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local targetRoot = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
            
            if myRoot and targetRoot then
                local distance = (myRoot.Position - targetRoot.Position).Magnitude
                playerFar.Text = "距離: " .. math.floor(distance) .. " 單位"
            end
        end
        
        if currentTarget then
            playerName.Text = currentTarget.Name
            playerIDs.Text = "ID: " .. tostring(currentTarget.UserId)
        end
        
        showFeedback("停止追蹤", 
            "已停止追蹤 " .. (currentTarget and currentTarget.Name or "目標") .. "\n穿牆模式已自動關閉")
    end
    
    local function toggleMinimize()
        playClick()
        
        if not isMinimized then
            local framePos = frame.Position
            
            frame.Visible = false
            controlFrame.Visible = false
            minimizedFrame.Visible = true
            minimizedFrame.Position = framePos
            
            isMinimized = true
            minimizeButton.Text = "展開"
        else
            local minimizedPos = minimizedFrame.Position
            
            minimizedFrame.Visible = false
            frame.Visible = true
            frame.Position = minimizedPos
            
            isMinimized = false
            minimizeButton.Text = "縮小"
        end
    end
    
    -- 立即更新玩家信息（不延遲）
    local function updatePlayerInfoImmediately()
        if not currentTarget then 
            playerName.Text = "請選擇玩家"
            playerIDs.Text = "ID: -"
            playerFar.Text = "距離: -"
            profileImage.Image = "rbxassetid://12222223187"
            return 
        end
        
        -- 立即更新名字和ID
        playerName.Text = currentTarget.Name
        playerIDs.Text = "ID: " .. tostring(currentTarget.UserId)
        
        -- 立即設置頭像（不等待）
        local thumbnail = loadPlayerThumbnail(currentTarget)
        pcall(function()
            profileImage.Image = thumbnail
        end)
        
        -- 計算距離
        if player.Character and currentTarget.Character then
            local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            
            if myRoot and targetRoot then
                local distance = (myRoot.Position - targetRoot.Position).Magnitude
                
                local statusText = ""
                if isTracking then
                    local currentSpeed = math.floor(FlyingTrackSystem.TrackSpeed)
                    local modeText = FlyingTrackSystem.UseDirectPath and "直線" or "正常"
                    local noClipText = FlyingTrackSystem.NoClipSystem.Enabled and "穿牆" or ""
                    statusText = string.format(" (追蹤中 - 速度: %d [%s%s])", currentSpeed, modeText, 
                        noClipText ~= "" and " " .. noClipText or "")
                    
                    playerName.Text = "追蹤中: " .. currentTarget.Name
                    
                    if noClipText ~= "" then
                        playerName.Text = playerName.Text .. " (穿牆中)"
                    end
                end
                
                playerFar.Text = "距離: " .. math.floor(distance) .. " 單位" .. statusText
            else
                playerFar.Text = "距離: N/A"
            end
        else
            playerFar.Text = "距離: N/A"
        end
    end
    
    -- 只更新距離（優化性能）
    local function updateDistanceOnly()
        if not currentTarget or not player.Character or not currentTarget.Character then
            return
        end
        
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        
        if not myRoot or not targetRoot then
            return
        end
        
        local distance = (myRoot.Position - targetRoot.Position).Magnitude
        local now = tick()
        
        -- 每0.3秒更新一次距離（避免過度計算）
        if now - lastDistanceUpdate > 0.3 then
            lastDistanceUpdate = now
            
            local statusText = ""
            if isTracking then
                local currentSpeed = math.floor(FlyingTrackSystem.TrackSpeed)
                local modeText = FlyingTrackSystem.UseDirectPath and "直線" or "正常"
                local noClipText = FlyingTrackSystem.NoClipSystem.Enabled and "穿牆" or ""
                statusText = string.format(" (追蹤中 - 速度: %d [%s%s])", currentSpeed, modeText, 
                    noClipText ~= "" and " " .. noClipText or "")
            end
            
            playerFar.Text = "距離: " .. math.floor(distance) .. " 單位" .. statusText
        end
    end
    
    local function getNextTarget()
        if currentTarget then
            profileCache[currentTarget.UserId] = nil
        end
        
        playerList = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                table.insert(playerList, plr)
            end
        end
        
        if #playerList == 0 then
            currentTarget = nil
            playerName.Text = "請選擇玩家"
            playerIDs.Text = "ID: -"
            playerFar.Text = "距離: -"
            profileImage.Image = "rbxassetid://12222223187"
            return
        end
        
        if not currentTarget then
            currentTarget = playerList[1]
        else
            local index = table.find(playerList, currentTarget) or 0
            index = index + 1
            if index > #playerList then index = 1 end
            currentTarget = playerList[index]
        end
        
        -- 立即更新UI，不等待
        updatePlayerInfoImmediately()
    end
    
    local function setupButtonHoverEffect(button)
        local originalColor = button.BackgroundColor3
        
        button.MouseEnter:Connect(function()
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end)
        
        button.MouseLeave:Connect(function()
            button.BackgroundColor3 = originalColor
        end)
    end
    
    local function cleanup()
        if isTracking then
            stopFlyingTrack()
        end
    end
    
    -- 初始化
    showFeedback("飛行追蹤系統", "系統已啟動！\n追蹤時自動穿牆 ✓")
    
    -- 標題動畫
    task.spawn(function()
        while true do
            if title and title.TextStrokeTransparency then
                for i = 0.2, 0.6, 0.04 do
                    if title and title.TextStrokeTransparency then
                        title.TextStrokeTransparency = i
                        task.wait(0.07)
                    else
                        break
                    end
                end
                for i = 0.6, 0.2, -0.04 do
                    if title and title.TextStrokeTransparency then
                        title.TextStrokeTransparency = i
                        task.wait(0.07)
                    else
                        break
                    end
                end
            else
                task.wait(0.5)
            end
        end
    end)
    
    -- 設置按鈕懸停效果
    RunService.RenderStepped:Wait()
    setupButtonHoverEffect(trackButton)
    setupButtonHoverEffect(skipButton)
    setupButtonHoverEffect(settingsButton)
    setupButtonHoverEffect(autoNoClipButton)
    setupButtonHoverEffect(directPathButton)
    setupButtonHoverEffect(minimizeButton)
    setupButtonHoverEffect(expandButton)
    setupButtonHoverEffect(trackSpeedMinus)
    setupButtonHoverEffect(trackSpeedPlus)
    
    updateTrackSpeedDisplay()
    updateAutoNoClipButton()
    
    -- 按鈕事件
    minimizeButton.MouseButton1Click:Connect(toggleMinimize)
    expandButton.MouseButton1Click:Connect(toggleMinimize)
    
    trackSpeedMinus.MouseButton1Click:Connect(function()
        adjustTrackSpeed(-10)
    end)
    
    trackSpeedPlus.MouseButton1Click:Connect(function()
        adjustTrackSpeed(10)
    end)
    
    autoNoClipButton.MouseButton1Click:Connect(function()
        playClick()
        
        FlyingTrackSystem.AutoNoClipEnabled = not FlyingTrackSystem.AutoNoClipEnabled
        
        updateAutoNoClipButton()
        
        if FlyingTrackSystem.AutoNoClipEnabled then
            showFeedback("追蹤穿牆", "已啟用追蹤時自動穿牆\n下次追蹤時生效")
        else
            showFeedback("追蹤穿牆", "已關閉追蹤時自動穿牆\n穿牆模式已關閉")
            
            if isTracking then
                FlyingTrackSystem.NoClipSystem:DisableNoClip()
            end
        end
    end)
    
    directPathButton.MouseButton1Click:Connect(function()
        playClick()
        
        FlyingTrackSystem.UseDirectPath = not FlyingTrackSystem.UseDirectPath
        
        if FlyingTrackSystem.UseDirectPath then
            directPathButton.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
            directPathButton.Text = "直線追蹤: ✓"
            showFeedback("追蹤模式", "已切換為直線追蹤模式")
        else
            directPathButton.BackgroundColor3 = Color3.fromRGB(60, 180, 255)
            directPathButton.Text = "直線追蹤: ✗"
            showFeedback("追蹤模式", "已切換為正常追蹤模式")
        end
    end)
    
    -- 速度滑動條控制
    local isDraggingTrackSpeedSlider = false
    local trackSpeedSliderStartX = 0
    local trackSpeedSliderStartPercent = 0
    
    trackSpeedSlider.MouseButton1Down:Connect(function()
        playClick()
        isDraggingTrackSpeedSlider = true
        trackSpeedSliderStartX = UserInputService:GetMouseLocation().X
        trackSpeedSliderStartPercent = (FlyingTrackSystem.TrackSpeed - FlyingTrackSystem.MinSpeed) / 
                                     (FlyingTrackSystem.MaxSpeed - FlyingTrackSystem.MinSpeed)
        
        trackSpeedSlider.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    end)
    
    RunService.RenderStepped:Connect(function()
        if isDraggingTrackSpeedSlider then
            local mouseX = UserInputService:GetMouseLocation().X
            local deltaX = mouseX - trackSpeedSliderStartX
            
            local percentChange = deltaX / 200
            local newPercent = math.clamp(trackSpeedSliderStartPercent + percentChange, 0, 1)
            
            local newSpeed = math.floor(
                FlyingTrackSystem.MinSpeed + 
                (newPercent * (FlyingTrackSystem.MaxSpeed - FlyingTrackSystem.MinSpeed)) + 0.5
            )
            
            FlyingTrackSystem.TrackSpeed = newSpeed
            local originalSpeed = newSpeed / FlyingTrackSystem.SpeedSystem.SpeedScale
            FlyingTrackSystem.SpeedSystem.CurrentSpeed = math.max(1, math.floor(originalSpeed))
            
            updateTrackSpeedDisplay()
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if isDraggingTrackSpeedSlider then
                isDraggingTrackSpeedSlider = false
                trackSpeedSlider.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            end
        end
    end)
    
    -- UI拖拽
    local dragging = false
    local dragStart, startPos
    local dragTween
    
    local function updateDrag(input)
        local delta = input.Position - dragStart
        local newPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        if dragTween then dragTween:Cancel() end
        dragTween = TweenService:Create(frame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = newPos})
        dragTween:Play()
    end
    
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateDrag(input)
        end
    end)
    
    -- 主要按鈕事件
    skipButton.MouseButton1Click:Connect(function()
        playClick()
        
        if isTracking then
            stopFlyingTrack()
        end
        
        getNextTarget()
        
        if isTracking and currentTarget then
            task.wait(0.1)
            startFlyingTrack()
        end
        
        if currentTarget then
            showFeedback("目標已切換", "當前目標: " .. currentTarget.Name)
        end
    end)
    
    settingsButton.MouseButton1Click:Connect(function()
        if isMinimized then
            toggleMinimize()
            task.wait(0.1)
        end
        
        playClick()
        controlFrame.Visible = not controlFrame.Visible
        
        if controlFrame.Visible then
            controlFrame.Position = UDim2.new(frame.Position.X.Scale, frame.Position.X.Offset, 
                                            frame.Position.Y.Scale + frame.Size.Y.Scale + 0.02, 0)
        end
    end)
    
    closeSettingsButton.MouseButton1Click:Connect(function()
        playClick()
        controlFrame.Visible = false
    end)
    
    closeButton.MouseButton1Click:Connect(function()
        playClick()
        frame.Visible = false
        minimizedFrame.Visible = false
        controlFrame.Visible = false
        FlyingTrackSystem:StopTracking()
    end)
    
    trackButton.MouseButton1Click:Connect(function()
        playClick()
        
        if not currentTarget then
            showFeedback("錯誤", "請先選擇一個玩家", true)
            return
        end
        
        if currentTarget == player then
            showFeedback("錯誤", "無法追蹤自己", true)
            return
        end
        
        if not isTracking then
            startFlyingTrack()
        else
            stopFlyingTrack()
        end
    end)
    
    -- 初始化玩家列表
    getNextTarget()
    
    -- 角色事件處理
    player.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        
        if isTracking then
            stopFlyingTrack()
            task.wait(1)
            startFlyingTrack()
        end
    end)
    
    player.CharacterRemoving:Connect(cleanup)
    
    -- 玩家離開事件
    Players.PlayerRemoving:Connect(function(leavingPlayer)
        if leavingPlayer == player or leavingPlayer == currentTarget then
            if isTracking then
                stopFlyingTrack()
            end
            profileCache[leavingPlayer.UserId] = nil
        end
    end)
    
    -- 新玩家加入
    Players.PlayerAdded:Connect(function(newPlayer)
        task.wait(0.5)
        if not currentTarget then
            getNextTarget()
        end
    end)
    
    -- 即時距離更新循環
    task.spawn(function()
        while true do
            if currentTarget then
                updateDistanceOnly()
            end
            task.wait(0.1)
        end
    end)
end

-- 啟動主腳本
createMainScript()

-- 全局清理
game:BindToClose(function()
    if FlyingTrackSystem then
        FlyingTrackSystem:StopTracking()
    end
end)

return FlyingTrackSystem
