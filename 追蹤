Players.PlayerAdded:Connect(function(player)
    if currentSelectedPlayer == nil then
        -- 如果有新玩家加入且當前未選擇玩家，自動選擇第一個其他玩家
        if player ~= LocalPlayer then
            currentSelectedPlayer = player
            updatePlayerInfo(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if currentSelectedPlayer == player then
        -- 如果當前選擇的玩家離開，選擇其他玩家
        local allPlayers = Players:GetPlayers()
        local newPlayer = nil
        
        for _, p in ipairs(allPlayers) do
            if p ~= LocalPlayer and p ~= player then
                newPlayer = p
                break
            end
        end
        
        currentSelectedPlayer = newPlayer
        updatePlayerInfo(newPlayer)
        
        -- 如果正在追蹤該玩家，停止追蹤
        if FlyingTrackSystem.IsTracking and FlyingTrackSystem._currentTarget == player then
            FlyingTrackSystem:StopTracking()
        end
    end
end)

