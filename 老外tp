local function EMKXIS_fake_script() -- c00ltpframe.CoreScripts 
	local script = Instance.new('LocalScript', c00ltpframe)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local StarterGui = game:GetService("StarterGui")
	
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	
	local frame = script.Parent
	local spectateButton = frame:WaitForChild("SpectateButton")
	local skipButton = frame:WaitForChild("SkipButton")
	local closeButton = frame:WaitForChild("CloseButton")
	local teleport = frame:WaitForChild("TeleportButton")
	
	local playerName = frame:WaitForChild("PlayerName")
	local playerIDs = frame:WaitForChild("PlayerIDs")
	local playerFar = frame:WaitForChild("PlayerFar")
	local title = frame:WaitForChild("Title")
	local profileImage = frame:WaitForChild("PlayerProfiles")
	
	local currentTarget = nil
	local playerList = {}
	local spectating = false
	
	local clickSound = Instance.new("Sound")
	clickSound.SoundId = "rbxassetid://12221967"
	clickSound.Volume = 1
	clickSound.Parent = frame
	
	local function playClick()
		clickSound:Play()
	end
	
	game.StarterGui:SetCore("SendNotification", {
		Title = "Thank you for using my script!",
		Text = "youtube/masswe11lll",
		Duration = 3,
		Icon = "rbxassetid://6376283901"
	})
	
	local dragging = false
	local dragStart, startPos
	local dragTween
	
	local function updateDrag(input)
		local delta = input.Position - dragStart
		local newPos = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		if dragTween then dragTween:Cancel() end
		dragTween = TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = newPos})
		dragTween:Play()
	end
	
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateDrag(input)
		end
	end)
	
	local function updatePlayerInfo()
		if not currentTarget then return end
		playerName.Text = "Name: " .. currentTarget.Name
		playerIDs.Text = "UserId: " .. currentTarget.UserId
		if player.Character and currentTarget.Character then
			local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
			if myRoot and targetRoot then
				local distance = (myRoot.Position - targetRoot.Position).Magnitude
				playerFar.Text = "Distance: " .. math.floor(distance) .. " studs"
			else
				playerFar.Text = "Distance: N/A"
			end
		else
			playerFar.Text = "Distance: N/A"
		end
		local thumbType = Enum.ThumbnailType.HeadShot
		local thumbSize = Enum.ThumbnailSize.Size150x150
		local content, isReady = Players:GetUserThumbnailAsync(currentTarget.UserId, thumbType, thumbSize)
		profileImage.Image = content
	end
	
	local function getNextTarget()
		playerList = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				table.insert(playerList, plr)
			end
		end
		if #playerList == 0 then
			currentTarget = nil
			return
		end
		if not currentTarget then
			currentTarget = playerList[1]
		else
			local index = table.find(playerList, currentTarget) or 0
			index = index + 1
			if index > #playerList then index = 1 end
			currentTarget = playerList[index]
		end
		updatePlayerInfo()
	end
	
	task.spawn(function()
		while true do
			if currentTarget then
				updatePlayerInfo()
			end
			task.wait(1)
		end
	end)
	
	skipButton.MouseButton1Click:Connect(function()
		playClick()
		getNextTarget()
	end)
	
	closeButton.MouseButton1Click:Connect(function()
		playClick()
		frame.Visible = false
	end)
	
	teleport.MouseButton1Click:Connect(function()
		playClick()
		if currentTarget and currentTarget ~= player then
			if player.Character and currentTarget.Character then
				local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
				local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
				if myRoot and targetRoot then
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
				end
			end
		end
	end)
	
	spectateButton.MouseButton1Click:Connect(function()
		playClick()
		if not currentTarget or currentTarget == player then return end
		if not spectating then
			if currentTarget.Character and currentTarget.Character:FindFirstChild("Humanoid") then
				camera.CameraSubject = currentTarget.Character.Humanoid
				spectating = true
			end
		else
			if player.Character and player.Character:FindFirstChild("Humanoid") then
				camera.CameraSubject = player.Character.Humanoid
				spectating = false
			end
		end
	end)
	
	getNextTarget()
	
end
coroutine.wrap(EMKXIS_fake_script)()
