-- [[ 核心模組設定 ]]
local SilentAimModule = {}
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local commE = RS:WaitForChild("Remotes"):WaitForChild("CommE")
local MouseModule = RS:FindFirstChild("Mouse")

-- 全域變數
local SilentAimPlayersEnabled = false
local PredictionEnabled = true
local PredictionAmount = 0.12 
local maxRange = 1000
local PlayersPosition = nil

-- 技能過濾清單
local Skills = {"Z", "X", "C", "V"}
local Booms = {"TAP", "MainClick"} 

-- [[ 1. 核心鎖定邏輯 ]]
local function getHRP(model)
    return model and model:FindFirstChild("HumanoidRootPart")
end

local function getPredictedPosition(targetChar)
    local hrp = getHRP(targetChar)
    if not hrp then return nil end
    local velocity = hrp.Velocity
    if not PredictionEnabled or velocity.Magnitude < 2 then
        return hrp.Position
    end
    return hrp.Position + (velocity * PredictionAmount)
end

local function getClosestPlayer()
    local closest = nil
    local dist = maxRange
    local lpHRP = getHRP(player.Character)
    if not lpHRP then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local targetHRP = getHRP(p.Character)
                if targetHRP then
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude
                    if d < dist then
                        dist = d
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

-- [[ 2. 修正版 Hook ]]
spawn(function()
    local ok, hookMeta = pcall(getrawmetatable, game)
    if ok and hookMeta then
        setreadonly(hookMeta, false)
        local OldHook
        OldHook = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if SilentAimPlayersEnabled and PlayersPosition then
                if method == "FireServer" or method == "InvokeServer" then
                    if typeof(args[1]) == "Vector3" then
                        args[1] = PlayersPosition
                        return OldHook(self, unpack(args))
                    elseif type(args[1]) == "string" and (table.find(Skills, args[1]:upper()) or table.find(Booms, args[1])) then
                        if #args >= 2 then
                            args[2] = PlayersPosition
                        end
                        return OldHook(self, unpack(args))
                    end
                end
            end
            return OldHook(self, ...)
        end)
        setreadonly(hookMeta, true)
    end
end)

-- [[ 3. 渲染與追蹤迴圈 ]]
RunService.Heartbeat:Connect(function()
    if not SilentAimPlayersEnabled then 
        PlayersPosition = nil
        return 
    end

    local target = getClosestPlayer()
    if target and target.Character then
        PlayersPosition = getPredictedPosition(target.Character)
        
        if MouseModule then
            local ok, m = pcall(require, MouseModule)
            if ok and type(m) == "table" then
                m.Hit = CFrame.new(PlayersPosition)
            end
        end
    else
        PlayersPosition = nil
    end
end)

