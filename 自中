-- [[ 核心模組設定 ]] 
local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 
local Camera = workspace.CurrentCamera

-- 全域變數 
local SilentAimEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local maxRange = 1000 
local TargetPosition = nil 
 
-- [[ 1. 核心鎖定邏輯 ]] 
local function getHRP(model) 
    return model and model:FindFirstChild("HumanoidRootPart") 
end 
 
local function getPredictedPosition(targetChar) 
    local hrp = getHRP(targetChar) 
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 
 
local function getClosestPlayer() 
    local closest = nil 
    local dist = maxRange 
    local lpHRP = getHRP(player.Character) 
    if not lpHRP then return nil end 
 
    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = getHRP(p.Character) 
                if targetHRP then 
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude 
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end 
                end 
            end 
        end 
    end 
    return closest 
end 
 
-- [[ 2. 極簡安全版 Hook (解決特效消失與 UI 衝突) ]] 
local function IsMouseOverUI()
    local mousePos = UserInputService:GetMouseLocation()
    local objects = player.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
    for _, obj in ipairs(objects) do
        if obj.Visible and obj.Active then
            return true
        end
    end
    return false
end

local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(t, k)
    -- 僅在非腳本調用、自瞄開啟、有目標、且滑鼠不在 UI 上時執行
    if not checkcaller() and SilentAimEnabled and TargetPosition and not IsMouseOverUI() then
        if typeof(t) == "Instance" and t:IsA("Mouse") then
            if k == "Hit" then
                return CFrame.new(TargetPosition)
            elseif k == "Target" then
                local target = getClosestPlayer()
                return target and getHRP(target.Character)
            end
        end
    end
    return oldIndex(t, k)
end)

setreadonly(mt, true)
 
-- [[ 3. 追蹤迴圈 ]] 
RunService.Heartbeat:Connect(function() 
    if not SilentAimEnabled then 
        TargetPosition = nil 
        return 
    end 
 
    local target = getClosestPlayer() 
    if target and target.Character then 
        TargetPosition = getPredictedPosition(target.Character) 
    else 
        TargetPosition = nil 
    end 
end) 
 
