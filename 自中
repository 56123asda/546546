-- [[ 核心模組設定 ]] 
local SilentAimModule = {} 
local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 
local RS = game:GetService("ReplicatedStorage") 
local Camera = workspace.CurrentCamera

-- 全域變數 
local SilentAimPlayersEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local maxRange = 1000 
local PlayersPosition = nil 
 
-- 技能過濾清單 
local Skills = {"Z", "X", "C", "V"} 
local Booms = {"TAP", "MainClick"} 
 
-- [[ 1. 核心鎖定邏輯 ]] 
local function getHRP(model) 
    return model and model:FindFirstChild("HumanoidRootPart") 
end 
 
local function getPredictedPosition(targetChar) 
    local hrp = getHRP(targetChar) 
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 
 
local function getClosestPlayer() 
    local closest = nil 
    local dist = maxRange 
    local lpHRP = getHRP(player.Character) 
    if not lpHRP then return nil end 
 
    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = getHRP(p.Character) 
                if targetHRP then 
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude 
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end 
                end 
            end 
        end 
    end 
    return closest 
end 
 
-- [[ 2. 安全版 Hook (修復 UI 消失問題) ]] 
pcall(function() 
    local mt = getrawmetatable(game) 
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index
    setreadonly(mt, false) 
    
    -- 修改 __namecall：精確攔截戰鬥指令
    mt.__namecall = newcclosure(function(self, ...) 
        local method = getnamecallmethod() 
        local args = {...} 
        
        if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition then 
            -- 僅針對 Blox Fruits 戰鬥 Remote "CommE" 進行攔截
            if (method == "FireServer" or method == "InvokeServer") and self.Name == "CommE" then 
                if type(args[1]) == "string" then
                    local cmd = args[1]:upper()
                    if table.find(Skills, cmd) or table.find(Booms, args[1]) then
                        if #args >= 2 and typeof(args[2]) == "Vector3" then
                            args[2] = PlayersPosition
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end 
        end 
        return oldNamecall(self, ...) 
    end) 

    -- 修改 __index：安全修改滑鼠位置 (取代損壞的 MouseModule)
    mt.__index = newcclosure(function(t, k)
        if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition and typeof(t) == "Instance" and t:IsA("Mouse") then
            if k == "Hit" then
                return CFrame.new(PlayersPosition)
            elseif k == "Target" then
                local target = getClosestPlayer()
                return target and getHRP(target.Character)
            end
        end
        return oldIndex(t, k)
    end)
    
    setreadonly(mt, true) 
end) 
 
-- [[ 3. 渲染與追蹤迴圈 ]] 
RunService.Heartbeat:Connect(function() 
    if not SilentAimPlayersEnabled then 
        PlayersPosition = nil 
        return 
    end 
 
    local target = getClosestPlayer() 
    if target and target.Character then 
        PlayersPosition = getPredictedPosition(target.Character) 
    else 
        PlayersPosition = nil 
    end 
end) 
 
