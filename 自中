-- [[ 小傑獨立靜默自瞄腳本 - 安全修復版 ]] 
-- 說明：此腳本為獨立運作，已修正會導致遊戲 UI 消失的問題。

local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 
local RS = game:GetService("ReplicatedStorage") 

-- [[ 配置變數 ]] 
local SilentAimPlayersEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local maxRange = 1000 
local PlayersPosition = nil 

-- 技能過濾清單 
local Skills = {"Z", "X", "C", "V"} 
local Booms = {"TAP", "MainClick"} 

-- [[ 1. 核心邏輯 ]] 
local function getHRP(model) 
    return model and model:FindFirstChild("HumanoidRootPart") 
end 

local function getPredictedPosition(targetChar) 
    local hrp = getHRP(targetChar) 
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 

local function getClosestPlayer() 
    local closest = nil 
    local dist = maxRange 
    local lpHRP = getHRP(player.Character) 
    if not lpHRP then return nil end 

    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = getHRP(p.Character) 
                if targetHRP then 
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude 
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end 
                end 
            end 
        end 
    end 
    return closest 
end 

-- [[ 2. 安全修正版 Hook ]] 
-- 修復重點：改為修改 Mouse.Hit 屬性，並同時攔截 Namecall 但僅針對特定參數類型
local function ApplySilentAimHook()
    local ok, Mouse = pcall(function() return player:GetMouse() end)
    if not ok or not Mouse then return end

    local ok2, mt = pcall(getrawmetatable, game)
    if ok2 and mt then
        local oldIndex = mt.__index
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        
        -- 1. 修改滑鼠屬性 (適用於大部分技能)
        mt.__index = newcclosure(function(self, key)
            if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition then
                if self == Mouse and (key == "Hit" or key == "Target") then
                    if key == "Hit" then
                        return CFrame.new(PlayersPosition)
                    elseif key == "Target" then
                        local target = getClosestPlayer()
                        return target and getHRP(target.Character) or oldIndex(self, key)
                    end
                end
            end
            return oldIndex(self, key)
        end)
        
        -- 2. 修改 Namecall (適用於直接發送 Vector3 的技能)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition then
                if method == "FireServer" or method == "InvokeServer" then
                    -- 關鍵修正：只在參數包含特定位置資訊時才修改，避免干擾 UI
                    if typeof(args[1]) == "Vector3" then
                        -- 如果距離目標太近或這顯然不是戰鬥 Remote，可以加更多判斷
                        args[1] = PlayersPosition
                        return oldNamecall(self, unpack(args))
                    elseif type(args[1]) == "string" and (table.find(Skills, args[1]:upper()) or table.find(Booms, args[1])) then
                        if #args >= 2 and typeof(args[2]) == "Vector3" then
                            args[2] = PlayersPosition
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end
end

-- 執行 Hook
ApplySilentAimHook()

-- [[ 3. 渲染與追蹤迴圈 ]] 
RunService.Heartbeat:Connect(function() 
    if not SilentAimPlayersEnabled then 
        PlayersPosition = nil 
        return 
    end 

    local target = getClosestPlayer() 
    if target and target.Character then 
        PlayersPosition = getPredictedPosition(target.Character) 
    else 
        PlayersPosition = nil 
    end 
end) 

