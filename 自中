-- [[ 核心設定 ]] 
local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 

-- 全域變數 
local SilentAimEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local maxRange = 1000 
local TargetPos = nil 
 
-- [[ 1. 核心鎖定邏輯 ]] 
local function getPredictedPosition(targetChar) 
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 
 
local function getClosestPlayer() 
    local closest = nil 
    local dist = maxRange 
    local lpHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not lpHRP then return nil end 
 
    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then 
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude 
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end 
                end 
            end 
        end 
    end 
    return closest 
end 
 
-- [[ 2. 零衝突 Hook (解決 UI 消失與技能失效) ]] 
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(t, k)
    -- 核心防護：只在開啟自瞄且有目標時運作
    if not checkcaller() and SilentAimEnabled and TargetPos then
        -- 關鍵修復：檢查調用來源
        local callingScript = getcallingscript()
        local scriptName = callingScript and callingScript.Name or ""
        
        -- 僅允許戰鬥相關腳本獲取自瞄坐標，UI 腳本將獲取原始坐標
        if scriptName == "CombatFramework" or scriptName == "Main" or scriptName == "Combat" then
            if typeof(t) == "Instance" and t:IsA("Mouse") then
                if k == "Hit" then
                    return CFrame.new(TargetPos)
                elseif k == "Target" then
                    local target = getClosestPlayer()
                    return target and target.Character:FindFirstChild("HumanoidRootPart")
                end
            end
        end
    end
    return oldIndex(t, k)
end)

setreadonly(mt, true)
 
-- [[ 3. 追蹤迴圈 ]] 
RunService.Heartbeat:Connect(function() 
    if not SilentAimEnabled then 
        TargetPos = nil 
        return 
    end 
 
    local target = getClosestPlayer() 
    if target and target.Character then 
        TargetPos = getPredictedPosition(target.Character) 
    else 
        TargetPos = nil 
    end 
end) 
 
