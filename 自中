-- [[ 小傑獨立靜默自瞄腳本 V2 - 安全修復版 ]] 
-- 說明：此腳本為獨立運作，已修正會導致遊戲 UI 消失的問題。

local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 
local RS = game:GetService("ReplicatedStorage") 
local Camera = workspace.CurrentCamera

-- [[ 配置變數 ]] 
local SilentAimEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local MaxRange = 1000 
local TargetPart = "HumanoidRootPart"
local ShowFOV = true
local FOVRadius = 150

-- 技能與攻擊過濾清單 (Blox Fruits 特定)
local CombatRemotes = {"CommE", "RegisterHit", "RegisterAttack", "CommF_"}
local CombatMethods = {"FireServer", "InvokeServer"}

-- [[ 1. 核心邏輯 ]] 
local function getHRP(model) 
    return model and model:FindFirstChild("HumanoidRootPart") 
end 

local function getPredictedPosition(targetChar) 
    local hrp = getHRP(targetChar) 
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 

local function getClosestPlayer() 
    local closest = nil 
    local shortestDist = MaxRange 
    local mousePos = UserInputService:GetMouseLocation()
    local lpHRP = getHRP(player.Character) 
    if not lpHRP then return nil end 

    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = getHRP(p.Character) 
                if targetHRP then 
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHRP.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < FOVRadius and dist < shortestDist then 
                            shortestDist = dist 
                            closest = p 
                        end 
                    end
                end 
            end 
        end 
    end 
    return closest 
end 

-- [[ 2. 安全版 Hook ]] 
-- 僅攔截戰鬥相關的 Remote，不影響遊戲 UI 與系統操作
local ok, mt = pcall(getrawmetatable, game) 
if ok and mt then 
    local oldNamecall = mt.__namecall
    setreadonly(mt, false) 
    
    mt.__namecall = newcclosure(function(self, ...) 
        local method = getnamecallmethod() 
        local args = {...} 
        
        if SilentAimEnabled and not checkcaller() then
            if table.find(CombatMethods, method) and table.find(CombatRemotes, self.Name) then
                local target = getClosestPlayer()
                if target and target.Character then
                    local pos = getPredictedPosition(target.Character)
                    if pos then
                        -- 修正參數中的座標資訊
                        for i, arg in ipairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = pos
                            elseif typeof(arg) == "CFrame" then
                                args[i] = CFrame.new(pos)
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end 
        return oldNamecall(self, ...) 
    end) 
    setreadonly(mt, true) 
end 

-- [[ 3. FOV 視覺化 ]]
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Transparency = 0.8
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = SilentAimEnabled and ShowFOV
    if FOVCircle.Visible then
        FOVCircle.Position = UserInputService:GetMouseLocation()
        FOVCircle.Radius = FOVRadius
    end
end)

