-- [[ 小傑獨立靜默自瞄腳本 - 安全修復版 ]] 
-- 說明：此腳本為獨立運作，已修正會導致遊戲 UI 消失的問題。

local Players = game:GetService("Players") 
local player = Players.LocalPlayer 
local UserInputService = game:GetService("UserInputService")  
local RunService = game:GetService("RunService") 
local RS = game:GetService("ReplicatedStorage") 

-- [[ 配置變數 ]] 
local SilentAimPlayersEnabled = false 
local PredictionEnabled = true 
local PredictionAmount = 0.12 
local maxRange = 1000 
local PlayersPosition = nil 

-- 技能過濾清單 
local Skills = {"Z", "X", "C", "V"} 
local Booms = {"TAP", "MainClick"} 

-- [[ 1. 核心邏輯 ]] 
local function getHRP(model) 
    return model and model:FindFirstChild("HumanoidRootPart") 
end 

local function getPredictedPosition(targetChar) 
    local hrp = getHRP(targetChar) 
    if not hrp then return nil end 
    local velocity = hrp.Velocity 
    if not PredictionEnabled or velocity.Magnitude < 2 then 
        return hrp.Position 
    end 
    return hrp.Position + (velocity * PredictionAmount) 
end 

local function getClosestPlayer() 
    local closest = nil 
    local dist = maxRange 
    local lpHRP = getHRP(player.Character) 
    if not lpHRP then return nil end 

    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then 
            if p.Character.Humanoid.Health > 0 then 
                local targetHRP = getHRP(p.Character) 
                if targetHRP then 
                    local d = (targetHRP.Position - lpHRP.Position).Magnitude 
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end 
                end 
            end 
        end 
    end 
    return closest 
end 

-- [[ 2. 安全修正版 Hook ]] 
-- 採用「三重保護」機制，徹底解決 UI 消失問題，同時支持所有前衝與座標技能
local function ApplySilentAimHook()
    local ok, Mouse = pcall(function() return player:GetMouse() end)
    if not ok or not Mouse then return end

    local ok2, mt = pcall(getrawmetatable, game)
    if ok2 and mt then
        local oldIndex = mt.__index
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        
        -- 保護名單：絕對不攔截這些名稱的 Remote，防止 UI 消失
        local UI_Blacklist = {"HUDUpdate", "InventoryUpdate", "GetInventory", "equip", "unequip", "UpdatePlayerGui", "SetCore"}

        -- [第一重：滑鼠屬性 Hook] 最穩定，不影響網路與 UI
        mt.__index = newcclosure(function(self, key)
            if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition then
                if self == Mouse and (key == "Hit" or key == "Target") then
                    if key == "Hit" then return CFrame.new(PlayersPosition)
                    elseif key == "Target" then
                        local target = getClosestTarget()
                        return target and getHRP(target.Character) or oldIndex(self, key)
                    end
                end
            end
            return oldIndex(self, key)
        end)
        
        -- [第二重：Surgical Namecall Hook] 僅針對戰鬥 Remote，且排除 UI 名單
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if not checkcaller() and SilentAimPlayersEnabled and PlayersPosition then
                if method == "FireServer" or method == "InvokeServer" then
                    local name = self.Name
                    
                    -- 檢查是否在黑名單中
                    for _, blacklisted in ipairs(UI_Blacklist) do
                        if name:find(blacklisted) then return oldNamecall(self, ...) end
                    end

                    -- 白名單：僅攔截特定的戰鬥/技能 Remote
                    -- 加上 self.Parent 檢查，通常戰鬥 Remote 都在 "Remotes" 文件夾
                    local isCombatRemote = (name == "CommE" or name == "RegisterHit" or name == "RegisterAttack") 
                    
                    if isCombatRemote then
                        -- 針對前衝與座標技能
                        if typeof(args[1]) == "Vector3" then
                            args[1] = PlayersPosition
                            return oldNamecall(self, unpack(args))
                        elseif type(args[1]) == "string" and (table.find(Skills, args[1]:upper()) or table.find(Booms, args[1])) then
                            for i = 2, #args do
                                if typeof(args[i]) == "Vector3" then
                                    args[i] = PlayersPosition
                                    break
                                end
                            end
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        
        setreadonly(mt, true)
    end
end

-- 執行 Hook
ApplySilentAimHook()

-- [[ 3. 渲染與追蹤迴圈 ]] 
local MouseModule = RS:FindFirstChild("Mouse") 
RunService.Heartbeat:Connect(function() 
    if not SilentAimPlayersEnabled then 
        PlayersPosition = nil 
        return 
    end 

    local target = getClosestPlayer() 
    if target and target.Character then 
        PlayersPosition = getPredictedPosition(target.Character) 
        
        -- [第三重：Mouse 模組 Hook] 處理依賴內部模組的果實技能
        if MouseModule then 
            local ok, m = pcall(require, MouseModule) 
            if ok and type(m) == "table" then 
                m.Hit = CFrame.new(PlayersPosition) 
            end 
        end 
    else 
        PlayersPosition = nil 
    end 
end) 

