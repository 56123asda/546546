local player = game.Players.LocalPlayer

-- 取得HumanoidRootPart的函數
local function getHumanoidRootPart()
    local character = player.Character
    if not character then
        character = player.CharacterAdded:Wait()
    end
    
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    return hrp
end

-- 移除岩漿函數
local function removeLava()
    while true do
        task.wait(1)
        
        pcall(function()
            local map = workspace:FindFirstChild("Map")
            if not map then return end
            
            local ghostShipInterior = map:FindFirstChild("GhostShipInterior")
            if not ghostShipInterior then return end
            
            local lavaParts = ghostShipInterior:FindFirstChild("LavaParts")
            if not lavaParts then return end
            
            local lava = lavaParts:FindFirstChild("Lava")
            if lava then
                lava:Destroy()
                print("Lava を削除しました。")
            end
        end)
    end
end

-- 安全傳送函數
local function safeTeleport(cframe, locationName)
    pcall(function()
        local hrp = getHumanoidRootPart()
        if hrp then
            hrp.CFrame = cframe
            print("テレポート：" .. locationName)
        end
    end)
end

